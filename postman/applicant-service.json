{
  "info": {
    "_postman_id": "7d64d67b-f69c-4d30-89d4-9b73fd6b1a53",
    "name": "Applicant service",
    "description": "Public Gateway requests for the Applicant service: administrator applicant presets and the assigned Moderator's applicant read. Set admin_token and moderator_token to Bearer access tokens for those roles, and set session_id and case_id for an active shift before the case read. Routes follow docs/contracts/api.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "gateway_url",
      "value": "http://127.0.0.1:8080"
    },
    {
      "key": "session_id",
      "value": ""
    },
    {
      "key": "case_id",
      "value": ""
    },
    {
      "key": "presetId",
      "value": ""
    },
    {
      "key": "admin_token",
      "value": ""
    },
    {
      "key": "moderator_token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Applicant presets",
      "item": [
        {
          "name": "Create preset",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('presetId', pm.response.json().preset_id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"label\": \"Postman FAF student\",\n  \"role\": \"student\",\n  \"university_status\": \"active\",\n  \"major\": \"FAF\",\n  \"year\": 1,\n  \"course_count\": 2,\n  \"enabled\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{gateway_url}}/api/v1/admin/applicant-presets"
          }
        },
        {
          "name": "List presets",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{gateway_url}}/api/v1/admin/applicant-presets?limit=50"
          }
        },
        {
          "name": "Get preset",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{gateway_url}}/api/v1/admin/applicant-presets/{{presetId}}"
          }
        },
        {
          "name": "Update preset",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"label\": \"Updated Postman FAF student\",\n  \"role\": \"student\",\n  \"university_status\": \"active\",\n  \"major\": \"FAF\",\n  \"year\": 1,\n  \"course_count\": 2,\n  \"enabled\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{gateway_url}}/api/v1/admin/applicant-presets/{{presetId}}"
          }
        },
        {
          "name": "Delete preset",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "url": "{{gateway_url}}/api/v1/admin/applicant-presets/{{presetId}}"
          }
        }
      ]
    },
    {
      "name": "Applicant cases",
      "item": [
        {
          "name": "Get applicant for session",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{gateway_url}}/api/v1/sessions/{{session_id}}/applicants/{{case_id}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{moderator_token}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{admin_token}}",
        "type": "string"
      }
    ]
  }
}
