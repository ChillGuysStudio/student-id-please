<mxfile host="app.diagrams.net">
  <diagram name="Architecture" id="6-gBOPLdTTZf2kjRfKdj">
    <mxGraphModel dx="-5217" dy="-4067" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&quot;data&quot;: &quot;---\nconfig:\n  layout: elk\n  theme: redux\n  look: neo\n  flowchart:\n    useMaxWidth: true\n---\nflowchart TB\n    %% Actors\n    C((\&quot;Client\&quot;))\n\n    %% Entry point\n    AGW{{\&quot;API Gateway (Go)&lt;br/&gt;Authorization + Routing\&quot;}}\n\n    %% Message broker\n    EB{{\&quot;RabbitMQ&lt;br/&gt;(AMQP Event Broker)&lt;br/&gt;Planned for Lab 4\&quot;}}\n\n    %% Java services\n    subgraph Java_Services [\&quot;Java services (Spring Boot)\&quot;]\n        AS[\&quot;Applicant Service\&quot;]\n        CS[\&quot;Credential Service\&quot;]\n        SRS[\&quot;Server Rules Service\&quot;]\n        URS[\&quot;University Record Service\&quot;]\n    end\n\n    %% Python services\n    subgraph Python_Services [\&quot;Python services (FastAPI)\&quot;]\n        PS[\&quot;Player Service\&quot;]\n        SMS[\&quot;Server Moderation&lt;br/&gt;Session Service\&quot;]\n        MS[\&quot;Moderation Service\&quot;]\n        DMS[\&quot;Discord DMs Service\&quot;]\n    end\n\n    %% Service-owned storage\n    dbAS[(\&quot;MongoDB&lt;br/&gt;(Claims and Case Metadata)\&quot;)] -.- AS\n    dbCS[(\&quot;MongoDB&lt;br/&gt;(Credentials and Validations)\&quot;)] -.- CS\n    dbSRS[(\&quot;PostgreSQL&lt;br/&gt;(Rule Versions)\&quot;)] -.- SRS\n    dbURS[(\&quot;MongoDB&lt;br/&gt;(University Facts&lt;br/&gt;and Record Permissions)\&quot;)] -.- URS\n\n    dbPS[(\&quot;PostgreSQL&lt;br/&gt;(Accounts, Profiles,&lt;br/&gt;Friendships, Teams, and XP)\&quot;)] -.- PS\n    dbMS[(\&quot;PostgreSQL&lt;br/&gt;(Decisions, Bans,&lt;br/&gt;Policy Snapshots, and&lt;br/&gt;Disciplinary Actions)\&quot;)] -.- MS\n\n    %% Services with PostgreSQL and Redis\n    dbSMS_Redis[(\&quot;Redis&lt;br/&gt;(Live State and Locks)\&quot;)] -.- SMS\n    dbSMS_PG[(\&quot;PostgreSQL&lt;br/&gt;(Shift History)\&quot;)] -.- SMS\n\n    dbDMS_Redis[(\&quot;Redis&lt;br/&gt;(Chat Tickets and&lt;br/&gt;WebSocket Pub/Sub)\&quot;)] -.- DMS\n    dbDMS_PG[(\&quot;PostgreSQL&lt;br/&gt;(Channels, Memberships,&lt;br/&gt;and Message History)\&quot;)] -.- DMS\n\n    %% 1. Client to API gateway\n    C &lt;--&gt;|\&quot;REST over HTTP&lt;br/&gt;(Includes WebSocket negotiation)\&quot;| AGW\n    C &lt;--&gt;|\&quot;WebSocket&lt;br/&gt;(Direct live chat)\&quot;| DMS\n\n    %% 2. REST routes via Gateway (client and service-to-service)\n    AGW &lt;--&gt;|\&quot;Route REST&lt;br/&gt;(Players, Friends, and Teams)&lt;br/&gt;Session: Validate team/player accounts&lt;br/&gt;Moderation: Validate disciplinary target\&quot;| PS\n    AGW &lt;--&gt;|\&quot;Route REST&lt;br/&gt;(Sessions, Roles,&lt;br/&gt;Cases, and Status)&lt;br/&gt;Moderation: Verify session context&lt;br/&gt;Discord DMs: Verify session role\&quot;| SMS\n    AGW &lt;--&gt;|\&quot;Route REST&lt;br/&gt;(Applicant Claims)&lt;br/&gt;Moderation: Fetch claims\&quot;| AS\n    AGW &lt;--&gt;|\&quot;Route REST&lt;br/&gt;(Credentials and Validation)&lt;br/&gt;Moderation: Fetch validations\&quot;| CS\n    AGW &lt;--&gt;|\&quot;Route REST&lt;br/&gt;(Rule Versions)&lt;br/&gt;Moderation: Evaluate policy\&quot;| SRS\n    AGW &lt;--&gt;|\&quot;Route REST&lt;br/&gt;(Permissions and Records)&lt;br/&gt;Moderation: Fetch university records&lt;br/&gt;Discord DMs: Verify record permissions\&quot;| URS\n    AGW &lt;--&gt;|\&quot;Route REST&lt;br/&gt;(Decisions, Bans, and&lt;br/&gt;Disciplinary Actions)\&quot;| MS\n    AGW &lt;--&gt;|\&quot;Route REST&lt;br/&gt;(Channels, History, Chat Tickets,&lt;br/&gt;and WebSocket Negotiation)\&quot;| DMS\n\n    %% 3. Planned for Lab 4: asynchronous RabbitMQ events\n    AS &lt;.-&gt;|\&quot;Publish and Subscribe&lt;br/&gt;(CaseInitialized)\&quot;| EB\n    CS &lt;.-&gt;|\&quot;Publish and Subscribe&lt;br/&gt;(CaseInitialized)\&quot;| EB\n    URS &lt;.-&gt;|\&quot;Publish and Subscribe&lt;br/&gt;(CaseInitialized)\&quot;| EB\n\n    MS -.-&gt;|\&quot;Publish&lt;br/&gt;(DecisionScored,&lt;br/&gt;DisciplinaryActionApplied)\&quot;| EB\n    EB -.-&gt;|\&quot;Subscribe&lt;br/&gt;(DecisionScored)\&quot;| SMS\n\n    SMS -.-&gt;|\&quot;Publish&lt;br/&gt;(ShiftEnded)\&quot;| EB\n    EB -.-&gt;|\&quot;Subscribe&lt;br/&gt;(ShiftEnded,&lt;br/&gt;DisciplinaryActionApplied)\&quot;| PS\n\n\n\n    %% Lab 4 components are intentionally greyed out\n    style EB fill:#E1E5E9,stroke:#707A86,color:#48525D,stroke-width:2.75px\n    linkStyle 20,21,22,23,24,25,26 stroke:#828C98,color:#5D6671,stroke-width:2.6px\n&quot;, &quot;config&quot;: null}" id="d26pXOuadLLMFYw6PhN9-121">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;fontSize=22;strokeWidth=0;" vertex="1">
