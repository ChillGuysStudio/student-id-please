{
  "info": {
    "_postman_id": "a4b9210f-2abd-4f96-a8e1-9a60deba3138",
    "name": "Credential service",
    "description": "Public Gateway requests for the Credential service. Credential templates needs admin_token for a global administrator. It creates a disabled template, because each kind allows only one enabled template. Credential cases needs moderator_token for the assigned Moderator of an active session, with session_id and case_id for its current case. Validate credential runs only when the case lists a credential. Denied requests also needs outsider_token for a player outside that session. Routes follow docs/contracts/api.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "gateway_url",
      "value": "http://127.0.0.1:8080"
    },
    {
      "key": "session_id",
      "value": ""
    },
    {
      "key": "case_id",
      "value": ""
    },
    {
      "key": "templateId",
      "value": ""
    },
    {
      "key": "credentialId",
      "value": ""
    },
    {
      "key": "admin_token",
      "value": ""
    },
    {
      "key": "moderator_token",
      "value": ""
    },
    {
      "key": "outsider_token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Credential templates",
      "item": [
        {
          "name": "Create template",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('template created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('templateId', pm.response.json().template_id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"kind\": \"student_id\",\n  \"issuer\": \"Technical University of Moldova\",\n  \"validity_days\": 365,\n  \"enabled\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{gateway_url}}/api/v1/admin/credential-templates"
          }
        },
        {
          "name": "List templates",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{gateway_url}}/api/v1/admin/credential-templates?limit=100"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('templates listed', () => pm.response.to.have.status(200));",
                  "pm.test('lists the new template', () => pm.expect(pm.response.json().items.map(item => item.template_id)).to.include(pm.collectionVariables.get('templateId')));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get template",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{gateway_url}}/api/v1/admin/credential-templates/{{templateId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('template read', () => pm.response.to.have.status(200));",
                  "pm.test('identity preserved', () => pm.expect(pm.response.json().template_id).to.eql(pm.collectionVariables.get('templateId')));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Update template",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"kind\": \"student_id\",\n  \"issuer\": \"Technical University of Moldova\",\n  \"validity_days\": 180,\n  \"enabled\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{gateway_url}}/api/v1/admin/credential-templates/{{templateId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('template updated', () => pm.response.to.have.status(200));",
                  "pm.test('validity updated', () => pm.expect(pm.response.json().validity_days).to.eql(180));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Delete template",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "url": "{{gateway_url}}/api/v1/admin/credential-templates/{{templateId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('template deleted', () => pm.response.to.have.status(204));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Credential cases",
      "item": [
        {
          "name": "List case credentials",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('credentials listed', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('returns a credential page', () => { pm.expect(body.items).to.be.an('array'); pm.expect(body).to.have.property('next_cursor'); });",
                  "pm.collectionVariables.set('credentialId', body.items.length ? body.items[0].credential_id : '');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{gateway_url}}/api/v1/sessions/{{session_id}}/cases/{{case_id}}/credentials?limit=50",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{moderator_token}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Validate credential",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{gateway_url}}/api/v1/sessions/{{session_id}}/credentials/{{credentialId}}/validation",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{moderator_token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "if (!pm.collectionVariables.get('credentialId')) pm.execution.skipRequest();"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('credential validated', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('validates the listed credential', () => { pm.expect(body.credential_id).to.eql(pm.collectionVariables.get('credentialId')); pm.expect(body.issues).to.be.an('array'); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Denied requests",
      "item": [
        {
          "name": "Reject credential list without token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('returns 401', () => pm.response.to.have.status(401));",
                  "pm.test('uses UNAUTHORIZED', () => pm.expect(pm.response.json().code).to.eql('UNAUTHORIZED'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{gateway_url}}/api/v1/sessions/{{session_id}}/cases/{{case_id}}/credentials",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Reject credential list outside the session",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('returns 403', () => pm.response.to.have.status(403));",
                  "pm.test('uses FORBIDDEN', () => pm.expect(pm.response.json().code).to.eql('FORBIDDEN'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{gateway_url}}/api/v1/sessions/{{session_id}}/cases/{{case_id}}/credentials",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{outsider_token}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Reject template list for a non-administrator",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('returns 403', () => pm.response.to.have.status(403));",
                  "pm.test('uses FORBIDDEN', () => pm.expect(pm.response.json().code).to.eql('FORBIDDEN'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{gateway_url}}/api/v1/admin/credential-templates",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{moderator_token}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{admin_token}}",
        "type": "string"
      }
    ]
  }
}
