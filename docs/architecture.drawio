  <diagram name="Page-1" id="PfpbHuHGPfrBLnos_OJD">
    <mxGraphModel dx="3491" dy="2129" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2856" pageHeight="2142" math="0" shadow="0" adaptiveColors="auto">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;---\nconfig:\n  layout: elk\n  theme: redux\n  look: neo\n  flowchart:\n    useMaxWidth: true\n---\nflowchart TB\n    %% Actors\n    C((\&quot;Client\&quot;))\n\n    %% Entry point\n    AGW{{\&quot;API gateway\&quot;}}\n\n    %% Message broker\n    EB{{\&quot;RabbitMQ&lt;br/&gt;(AMQP Event Broker)\&quot;}}\n\n    %% Java services\n    subgraph Java_Services [\&quot;Java services (Spring Boot)\&quot;]\n        AS[\&quot;Applicant Service\&quot;]\n        CS[\&quot;Credential Service\&quot;]\n        SRS[\&quot;Server Rules Service\&quot;]\n        URS[\&quot;University Record Service\&quot;]\n    end\n\n    %% Python services\n    subgraph Python_Services [\&quot;Python services (FastAPI)\&quot;]\n        PS[\&quot;Player Service\&quot;]\n        SMS[\&quot;Server Moderation&lt;br/&gt;Session Service\&quot;]\n        MS[\&quot;Moderation Service\&quot;]\n        DMS[\&quot;Discord DMs Service\&quot;]\n    end\n\n    %% Service-owned storage\n    dbAS[(\&quot;MongoDB&lt;br/&gt;(Claims and Case Metadata)\&quot;)] -.- AS\n    dbCS[(\&quot;MongoDB&lt;br/&gt;(Credentials and Validations)\&quot;)] -.- CS\n    dbSRS[(\&quot;PostgreSQL&lt;br/&gt;(Rule Versions)\&quot;)] -.- SRS\n    dbURS[(\&quot;MongoDB&lt;br/&gt;(University Facts&lt;br/&gt;and Record Permissions)\&quot;)] -.- URS\n\n    dbPS[(\&quot;PostgreSQL&lt;br/&gt;(Accounts, Profiles,&lt;br/&gt;Friendships, Teams, and XP)\&quot;)] -.- PS\n    dbMS[(\&quot;PostgreSQL&lt;br/&gt;(Decisions, Bans,&lt;br/&gt;Policy Snapshots, and&lt;br/&gt;Disciplinary Actions)\&quot;)] -.- MS\n\n    %% Services with PostgreSQL and Redis\n    dbSMS_Redis[(\&quot;Redis&lt;br/&gt;(Live State and Locks)\&quot;)] -.- SMS\n    dbSMS_PG[(\&quot;PostgreSQL&lt;br/&gt;(Shift History)\&quot;)] -.- SMS\n\n    dbDMS_Redis[(\&quot;Redis&lt;br/&gt;(Chat Tickets and&lt;br/&gt;WebSocket Pub/Sub)\&quot;)] -.- DMS\n    dbDMS_PG[(\&quot;PostgreSQL&lt;br/&gt;(Channels, Memberships,&lt;br/&gt;and Message History)\&quot;)] -.- DMS\n\n    %% 1. Client to API gateway\n    C &lt;--&gt;|\&quot;WebSocket\&quot;| AGW\n    C --&gt;|\&quot;REST over HTTP\&quot;| AGW\n\n    %% 2. Gateway Routes to Public Endpoints\n    AGW --&gt;|\&quot;Route REST&lt;br/&gt;(Authentication, Players,&lt;br/&gt;Friends, and Teams)\&quot;| PS\n    AGW --&gt;|\&quot;Route REST&lt;br/&gt;(Sessions, Roles,&lt;br/&gt;Cases, and Status)\&quot;| SMS\n    AGW --&gt;|\&quot;Route REST&lt;br/&gt;(Applicant Claims)\&quot;| AS\n    AGW --&gt;|\&quot;Route REST&lt;br/&gt;(Credentials and Validation)\&quot;| CS\n    AGW --&gt;|\&quot;Route REST&lt;br/&gt;(Rule Versions)\&quot;| SRS\n    AGW --&gt;|\&quot;Route REST&lt;br/&gt;(Permissions and Records)\&quot;| URS\n    AGW --&gt;|\&quot;Route REST&lt;br/&gt;(Decisions, Bans, and&lt;br/&gt;Disciplinary Actions)\&quot;| MS\n    AGW --&gt;|\&quot;Route REST&lt;br/&gt;(Channels, History,&lt;br/&gt;and Chat Tickets)\&quot;| DMS\n    AGW &lt;--&gt;|\&quot;Route WebSocket&lt;br/&gt;(Live Chat)\&quot;| DMS\n\n    %% 3. Asynchronous RabbitMQ events\n    AS &lt;.-&gt;|\&quot;Publish and Subscribe&lt;br/&gt;(CaseInitialized)\&quot;| EB\n    CS &lt;.-&gt;|\&quot;Publish and Subscribe&lt;br/&gt;(CaseInitialized)\&quot;| EB\n    URS &lt;.-&gt;|\&quot;Publish and Subscribe&lt;br/&gt;(CaseInitialized)\&quot;| EB\n\n    MS -.-&gt;|\&quot;Publish&lt;br/&gt;(DecisionScored,&lt;br/&gt;DisciplinaryActionApplied)\&quot;| EB\n    EB -.-&gt;|\&quot;Subscribe&lt;br/&gt;(DecisionScored)\&quot;| SMS\n\n    SMS -.-&gt;|\&quot;Publish&lt;br/&gt;(ShiftEnded)\&quot;| EB\n    EB -.-&gt;|\&quot;Subscribe&lt;br/&gt;(ShiftEnded,&lt;br/&gt;DisciplinaryActionApplied)\&quot;| PS\n\n    %% 4. Internal REST calls\n    SMS --&gt;|\&quot;REST: Validate Team and Player Accounts\&quot;| PS\n    MS --&gt;|\&quot;REST: Verify Session Context\&quot;| SMS\n    MS --&gt;|\&quot;REST: Validate Disciplinary Target\&quot;| PS\n    MS --&gt;|\&quot;REST: Fetch Claims\&quot;| AS\n    MS --&gt;|\&quot;REST: Fetch Validations\&quot;| CS\n    MS --&gt;|\&quot;REST: Fetch University Records\&quot;| URS\n    MS --&gt;|\&quot;REST: Evaluate Policy\&quot;| SRS\n\n    %% 5. Internal authorization checks\n    DMS -.-&gt;|\&quot;REST: Verify Session Role\&quot;| SMS\n    DMS -.-&gt;|\&quot;REST: Verify Record Permissions\&quot;| URS&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="joouVfInYJOyBVhZyn9s-1">
