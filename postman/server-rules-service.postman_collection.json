{"info":{"_postman_id":"a1b2c3d4-e5f6-4789-abcd-ef0123456789","name":"Server Rules Service local workflow","description":"Creates a draft ruleset, checks CRUD and publication guards, evaluates the CPR baseline fixtures, and reads the current version. Designed for repeated runs against a live database.","schema":"https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},"variable":[{"key":"base_url","value":"http://localhost:8081"},{"key":"admin_token","value":"local-admin-token"},{"key":"player_token","value":"local-player-token"},{"key":"session_token","value":"local-session-token"},{"key":"moderation_token","value":"local-moderation-token"}],"item":[{"name":"Draft rules","item":[{"name":"Create draft","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{admin_token}}"},{"key":"Idempotency-Key","value":"{{draft_key}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"rules\":[{\"rule_id\":\"{{rule_id}}\",\"priority\":5,\"kind\":\"major\",\"applies_to_roles\":[\"student\"],\"on_match\":\"reject\",\"allowed_channels\":[],\"condition\":{\"allowed_majors\":[\"FAF\"]}}],\"default_action\":\"reject\",\"default_channels\":[]}"},"url":"{{base_url}}/api/v1/rule-versions"},"event":[{"listen":"prerequest","script":{"exec":["pm.collectionVariables.set('draft_key', pm.variables.replaceIn('{{$guid}}'));","pm.collectionVariables.set('rule_id', pm.variables.replaceIn('{{$guid}}'));","pm.collectionVariables.set('publish_key', pm.variables.replaceIn('{{$guid}}'));","pm.collectionVariables.set('missing_id', pm.variables.replaceIn('{{$guid}}'));"]}},{"listen":"test","script":{"exec":["pm.test('draft created', () => pm.response.to.have.status(201));","pm.test('draft status', () => pm.expect(pm.response.json().status).to.eql('draft'));","pm.collectionVariables.set('draft_id', pm.response.json().rule_version);"]}}]},{"name":"Replay draft creation","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{admin_token}}"},{"key":"Idempotency-Key","value":"{{draft_key}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"rules\":[{\"rule_id\":\"{{rule_id}}\",\"priority\":5,\"kind\":\"major\",\"applies_to_roles\":[\"student\"],\"on_match\":\"reject\",\"allowed_channels\":[],\"condition\":{\"allowed_majors\":[\"FAF\"]}}],\"default_action\":\"reject\",\"default_channels\":[]}"},"url":"{{base_url}}/api/v1/rule-versions"},"event":[{"listen":"test","script":{"exec":["pm.test('creation replayed', () => pm.response.to.have.status(201));","pm.test('same version replayed', () => pm.expect(pm.response.json().rule_version).to.eql(pm.collectionVariables.get('draft_id')));"]}}]},{"name":"Reject changed idempotent request","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{admin_token}}"},{"key":"Idempotency-Key","value":"{{draft_key}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"rules\":[],\"default_action\":\"reject\",\"default_channels\":[]}"},"url":"{{base_url}}/api/v1/rule-versions"},"event":[{"listen":"test","script":{"exec":["pm.test('idempotency conflict', () => pm.response.to.have.status(409));","pm.test('uses idempotency code', () => pm.expect(pm.response.json().code).to.eql('IDEMPOTENCY_CONFLICT'));"]}}]},{"name":"Read draft as admin","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{admin_token}}"}],"url":"{{base_url}}/api/v1/rule-versions/{{draft_id}}"},"event":[{"listen":"test","script":{"exec":["pm.test('draft read', () => pm.response.to.have.status(200));","pm.test('identity preserved', () => pm.expect(pm.response.json().rule_version).to.eql(pm.collectionVariables.get('draft_id')));"]}}]},{"name":"Reject draft read as player","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{player_token}}"}],"url":"{{base_url}}/api/v1/rule-versions/{{draft_id}}"},"event":[{"listen":"test","script":{"exec":["pm.test('draft hidde