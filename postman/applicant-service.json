{
  "info": {
    "_postman_id": "7d64d67b-f69c-4d30-89d4-9b73fd6b1a53",
    "name": "Student ID Please - Applicant Service",
    "description": "Requests for every endpoint implemented by applicant-service. Start the service with Docker Compose, then import this collection into Postman.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8081" },
    { "key": "idempotencyKey", "value": "11111111-1111-4111-8111-111111111111" },
    { "key": "sessionId", "value": "22222222-2222-4222-8222-222222222222" },
    { "key": "caseId", "value": "" },
    { "key": "presetId", "value": "" }
  ],
  "item": [
    {
      "name": "Applicant presets",
      "item": [
        {
          "name": "Create preset",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('presetId', pm.response.json().preset_id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{idempotencyKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"label\": \"Postman FAF student\",\n  \"role\": \"student\",\n  \"university_status\": \"active\",\n  \"major\": \"FAF\",\n  \"year\": 1,\n  \"course_count\": 2,\n  \"enabled\": true\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/admin/applicant-presets"
          }
        },
        {
          "name": "List presets",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/admin/applicant-presets?limit=50"
          }
        },
        {
          "name": "Get preset",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/admin/applicant-presets/{{presetId}}"
          }
        },
        {
          "name": "Update preset",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "33333333-3333-4333-8333-333333333333" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"label\": \"Updated Postman FAF student\",\n  \"role\": \"student\",\n  \"university_status\": \"active\",\n  \"major\": \"FAF\",\n  \"year\": 1,\n  \"course_count\": 2,\n  \"enabled\": true\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/admin/applicant-presets/{{presetId}}"
          }
        },
        {
          "name": "Delete preset",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Idempotency-Key", "value": "44444444-4444-4444-8444-444444444444" }
            ],
            "url": "{{baseUrl}}/api/v1/admin/applicant-presets/{{presetId}}"
          }
        }
      ]
    },
    {
      "name": "Applicant cases",
      "item": [
        {
          "name": "Initialize case",
          "description": "This internal endpoint requires the service's session and university-record integrations to accept the supplied session.",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 202) {",
                  "  pm.collectionVariables.set('caseId', pm.response.json().case_id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "55555555-5555-4555-8555-555555555555" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"session_id\": \"{{sessionId}}\",\n  \"scenario\": \"eligible\",\n  \"seed\": \"postman-applicant-case\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/internal/v1/applicant/cases"
          }
        },
        {
          "name": "Get case status",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/internal/v1/applicant/cases/{{caseId}}/status"
          }
        },
        {
          "name": "Get applicant for session",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/sessions/{{sessionId}}/applicants/{{caseId}}"
          }
        },
        {
          "name": "Get applicant for moderation",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/internal/v1/applicants/{{caseId}}?session_id={{sessionId}}"
          }
        }
      ]
    }
  ]
}
