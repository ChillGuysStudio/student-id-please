{
  "info": {
    "name": "Read-only HTTP checks",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run the safe public folder without credentials. The private folder reads Discovery liveness on its private HTTP listener. Discovery's registry and status are gRPC, so neither folder reads or changes registry state."
  },
  "item": [
    {
      "name": "Safe public smoke",
      "item": [
        {
          "name": "Gateway liveness",
          "request": { "method": "GET", "url": "{{gateway_url}}/healthz" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Gateway health returns 200', () => pm.expect(pm.response.code).to.equal(200));",
            "pm.test('Gateway liveness reports ok', () => pm.expect(pm.response.json().status).to.equal('ok'));"
          ] } }]
        },
        {
          "name": "Private status is not public",
          "request": { "method": "GET", "url": "{{gateway_url}}/internal/v1/status" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Public listener hides private status', () => pm.expect(pm.response.code).to.equal(404));",
            "pm.test('Private status fields are absent', () => { const text = pm.response.text(); pm.expect(text).not.to.include('boot_id'); pm.expect(text).not.to.include('active_tasks'); });"
          ] } }]
        },
        {
          "name": "Private registry is not public",
          "request": { "method": "GET", "url": "{{gateway_url}}/internal/v1/discovery/instances" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Public listener hides Discovery registry', () => pm.expect(pm.response.code).to.equal(404));"
          ] } }]
        },
        {
          "name": "Protected player read denies anonymous caller",
          "request": { "method": "GET", "url": "{{gateway_url}}/api/v1/players/me" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Missing bearer is rejected', () => pm.expect(pm.response.code).to.equal(401));",
            "pm.test('No private Gateway attribution is public', () => { ['X-Gateway-Instance-Id', 'X-Gateway-Registration-Id', 'X-Gateway-Failure-Origin', 'X-Gateway-Backend-Instance-Id', 'X-Gateway-Backend-Registration-Id', 'X-Gateway-Backend-Attempt-Id'].forEach(key => pm.expect(pm.response.headers.has(key)).to.equal(false)); });"
          ] } }]
        }
      ]
    },
    {
      "name": "Private Discovery health",
      "item": [
        {
          "name": "Discovery liveness",
          "request": { "method": "GET", "url": "{{discovery_url}}/healthz" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Discovery health returns 200', () => pm.expect(pm.response.code).to.equal(200));",
            "pm.test('Discovery liveness reports ok', () => pm.expect(pm.response.json().status).to.equal('ok'));"
          ] } }]
        }
      ]
    }
  ]
}
