            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{service_token}}" },
              { "key": "Idempotency-Key", "value": "{{$guid}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\"session_id\":\"{{session_id}}\",\"scenario\":\"eligible\",\"seed\":\"postman-case\",\"subject_id\":\"{{subject_id}}\"}" },
            "url": "{{base_url}}/internal/v1/university-record/cases"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('case accepted', () => pm.response.to.have.status(202));", "pm.test('initial response is pending', () => pm.expect(pm.response.json().state).to.eql('pending'));", "pm.collectionVariables.set('case_id', pm.response.json().case_id);"] } }]
        },
        {
          "name": "Read case status",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{service_token}}" }],
            "url": "{{base_url}}/internal/v1/university-record/cases/{{case_id}}/status"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('case ready', () => pm.response.to.have.status(200));", "pm.test('state is ready', () => pm.expect(pm.response.json().state).to.eql('ready'));"] } }]
        },
        {
          "name": "Read complete university records",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{service_token}}" }],
            "url": "{{base_url}}/internal/v1/cases/{{case_id}}/university-records?session_id={{session_id}}"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('records returned', () => pm.response.to.have.status(200));", "pm.test('records are non-empty', () => pm.expect(pm.response.json().records.length).to.be.above(0));", "pm.test('subject retained', () => pm.expect(pm.response.json().subject_id).to.eql(pm.collectionVariables.get('subject_id')));", "pm.collectionVariables.set('original_case', pm.response.text());"] } }]
        }
      ]
    },
    {
      "name": "Read replace and delete every kind",
      "item": [
        {
          "name": "Collect this run's references",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }],
            "url": "{{base_url}}/api/v1/admin/university-data?limit=100"
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('list available', () => pm.response.to.have.status(200));",
            "const subject = pm.collectionVariables.get('subject_id');",
            "const ids = ['program_ref', 'course_ref', 'schedule_ref', 'year_ref'].map(k => pm.collectionVariables.get(k));",
            "const order = ['fcim_message', 'registration', 'outlook_group', 'schedule', 'enrollment', 'course', 'academic_year', 'program'];",
            "const rows = pm.response.json().items.filter(r => r.subject_id === subject || ids.includes(r.reference_id)).sort((a,b) => order.indexOf(a.kind) - order.indexOf(b.kind));",
            "pm.test('all eight kinds selected', () => pm.expect(new Set(rows.map(r => r.kind)).size).to.eql(8));",
            "pm.collectionVariables.set('crud_queue', JSON.stringify(rows));",
            "pm.collectionVariables.set('crud_index', 0);"
          ] } }]
        },
        {
          "name": "Read each reference",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }],
            "url": "{{base_url}}/api/v1/admin/university-data/{{crud_id}}"
          },
          "event": [
            { "listen": "prerequest", "script": { "exec": [
              "const rows = JSON.parse(pm.collectionVariables.get('crud_queue'));",
              "const row = rows[Number(pm.collectionVariables.get('crud_index'))];",
              "pm.collectionVariables.set('crud_id', row.reference_id);",
              "pm.collectionVariables.set('crud_kind', row.kind);",
              "const body = {kind: row.kind, subject_id: row.subject_id, data: row.data};",
              "if (row.kind === 'program') body.data.name = 'Replaced program';",
              "if (row.kind === 'course') body.data.title = 'Replaced course';",
              "if (row.kind === 'fcim_message') body.data.text = 'Replaced message';",
              "if (row.kind === 'enrollment') body.data.first_name = 'Larisa';",
              "pm.collectionVariables.set('crud_body', JSON.stringify(body));"
            ] } },
            { "listen": "test", "script": { "exec": [
              "pm.test('GET ' + pm.collectionVariables.get('crud_kind'), () => pm.response.to.have.status(200));"
            ] } }
          ]
        },
        {
          "name": "Replace each reference",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" },
              { "key": "Idempotency-Key", "value": "{{$guid}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{{crud_body}}" },
            "url": "{{base_url}}/api/v1/admin/university-data/{{crud_id}}"
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('PUT ' + pm.collectionVariables.get('crud_kind'), () => pm.response.to.have.status(200));",
            "pm.test('replacement data persisted', () => pm.expect(pm.response.json().data).to.deep.eql(JSON.parse(pm.collectionVariables.get('crud_body')).data));",
            "pm.test('reference identity retained', () => pm.expect(pm.response.json().reference_id).to.eql(pm.collectionVariables.get('crud_id')));"
          ] } }]
        },
        {
          "name": "Delete each reference",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" },
              { "key": "Idempotency-Key", "value": "{{$guid}}" }
            ],
            "url": "{{base_url}}/api/v1/admin/university-data/{{crud_id}}"
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('DELETE ' + pm.collectionVariables.get('crud_kind'), () => pm.response.to.have.status(204));",
            "pm.test('empty delete result', () => pm.expect(pm.response.text()).to.eql(''));"
          ] } }]
        },
        {
          "name": "Confirm each reference was deleted",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }],
            "url": "{{base_url}}/api/v1/admin/university-data/{{crud_id}}"
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('deleted ' + pm.collectionVariables.get('crud_kind') + ' is absent', () => pm.response.to.have.status(404));",
            "const index = Number(pm.collectionVariables.get('crud_index')) + 1;",
            "pm.collectionVariables.set('crud_index', index);",
            "if (index < JSON.parse(pm.collectionVariables.get('crud_queue')).length) pm.execution.setNextRequest('Read each reference');"
          ] } }]
        },
        {
          "name": "Case remains immutable after reference deletion",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{service_token}}" }],
            "url": "{{base_url}}/internal/v1/cases/{{case_id}}/university-records?session_id={{session_id}}"
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('case remains available', () => pm.response.to.have.status(200));",
            "pm.test('case is byte-for-byte unchanged', () => pm.expect(pm.response.text()).to.eql(pm.collectionVariables.get('original_case')));"
          ] } }]
        }
      ]
    }
  ]
}
