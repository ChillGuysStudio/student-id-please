          "event": [{ "listen": "test", "script": { "exec": ["pm.test('idempotency conflict', () => pm.response.to.have.status(409));", "pm.test('uses idempotency code', () => pm.expect(pm.response.json().code).to.eql('IDEMPOTENCY_CONFLICT'));"] } }]
