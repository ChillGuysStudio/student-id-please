            "url": "{{session_url}}/api/v1/sessions/{{session_id}}/participants",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{junior1_token}}",
                  "type": "string"
                }
              ]
            },
            "header": [
