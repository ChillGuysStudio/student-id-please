# scripts/setup.py creates ignored .env and .local/stack files for development.
# Service images default to latest in compose.yaml. Uncomment one to pin a version
# (owner/repo:version). Unset or empty means latest.
# GATEWAY_IMAGE=maxnoragami/gateway-service:VERSION
# DISCOVERY_IMAGE=maxnoragami/discovery-service:VERSION
# PLAYER_IMAGE=tirppy/student-id-player-service:VERSION
# SESSION_IMAGE=tirppy/student-id-session-service:VERSION
# MODERATION_IMAGE=sentientmoss/pad-moderation-service:VERSION
# DISCORD_DMS_IMAGE=sentientmoss/pad-discord-dms-service:VERSION
# APPLICANT_IMAGE=mcittkmims/applicant-service:VERSION
# CREDENTIAL_IMAGE=mcittkmims/credential-service:VERSION
# UNIVERSITY_RECORD_IMAGE=maxnoragami/university-record-service:VERSION
# SERVER_RULES_IMAGE=maxnoragami/server-rules-service:VERSION
GATEWAY_PORT=8080
# Host port of the DMs chat proxy, which balances the discord-dms replicas.
DMS_PORT=8009
HTTP_TASK_TIMEOUT_SECONDS=30
HTTP_MAX_CONCURRENT_TASKS=100
JAVA_TASK_TIMEOUT=30s
PLAYER_DB_PASSWORD=
SESSION_DB_PASSWORD=
MODERATION_DB_PASSWORD=
DMS_DB_PASSWORD=
BROKER_DB_PASSWORD=
REDIS_PASSWORD=
SESSION_SERVICE_TOKEN=
MODERATION_SERVICE_TOKEN=
DISCORD_DMS_SERVICE_TOKEN=
CHAT_TICKET_SECRET=
UNIVERSITY_MONGO_PASSWORD=
RULES_DB_PASSWORD=
RULES_CURSOR_SECRET=
# Grafana admin login (user admin). scripts/setup.py generates the password.
GRAFANA_ADMIN_PASSWORD=
# Host ports of Prometheus and Grafana, both bound to 127.0.0.1.
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
# Discovery registration. scripts/setup.py generates the tokens. Each process
# generates its own instance ID. Services reach Discovery at http://discovery:50051 over gRPC.
GATEWAY_CONTROL_TOKEN=
DISCOVERY_CONTROL_TOKEN=
OPERATOR_CONTROL_TOKEN=
APPLICANT_CONTROL_TOKEN=
CREDENTIAL_CONTROL_TOKEN=
UNIVERSITY_RECORD_CONTROL_TOKEN=
SERVER_RULES_CONTROL_TOKEN=
MODERATION_CONTROL_TOKEN=
PLAYER_CONTROL_TOKEN=
SESSION_CONTROL_TOKEN=
DISCORD_DMS_CONTROL_TOKEN=
# Prometheus authenticates to Discovery's target list. setup.py also writes the token to
# .local/stack/prometheus-control-token for the Prometheus container.
PROMETHEUS_CONTROL_TOKEN=
DISCOVERY_DISCORD_WEBHOOK_URL=
