{
  "info": {
    "_postman_id": "a4b9210f-2abd-4f96-a8e1-9a60deba3138",
    "name": "Credential service",
    "description": "Public Gateway requests for the Credential service: administrator credential templates, the credential list for a case, and credential validation. Set admin_token and moderator_token to Bearer access tokens for those roles, and set session_id and case_id for an active shift before the case requests. Routes follow docs/contracts/api.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "gateway_url",
      "value": "http://127.0.0.1:8080"
    },
    {
      "key": "session_id",
      "value": ""
    },
    {
      "key": "case_id",
      "value": ""
    },
    {
      "key": "templateId",
      "value": ""
    },
    {
      "key": "credentialId",
      "value": ""
    },
    {
      "key": "admin_token",
      "value": ""
    },
    {
      "key": "moderator_token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Credential templates",
      "item": [
        {
          "name": "Create template",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('templateId', pm.response.json().template_id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"kind\": \"student_id\",\n  \"issuer\": \"Technical University of Moldova\",\n  \"validity_days\": 365,\n  \"enabled\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{gateway_url}}/api/v1/admin/credential-templates"
          }
        },
        {
          "name": "List templates",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{gateway_url}}/api/v1/admin/credential-templates?limit=50"
          }
        },
        {
          "name": "Get template",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{gateway_url}}/api/v1/admin/credential-templates/{{templateId}}"
          }
        },
        {
          "name": "Update template",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"kind\": \"student_id\",\n  \"issuer\": \"Technical University of Moldova\",\n  \"validity_days\": 180,\n  \"enabled\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{gateway_url}}/api/v1/admin/credential-templates/{{templateId}}"
          }
        },
        {
          "name": "Delete template",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "url": "{{gateway_url}}/api/v1/admin/credential-templates/{{templateId}}"
          }
        }
      ]
    },
    {
      "name": "Credential cases",
      "item": [
        {
          "name": "List case credentials",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "if (pm.response.code === 200 && body.items.length > 0) {",
                  "  pm.collectionVariables.set('credentialId', body.items[0].credential_id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{gateway_url}}/api/v1/sessions/{{session_id}}/cases/{{case_id}}/credentials?limit=50",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{moderator_token}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Validate credential",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{gateway_url}}/api/v1/sessions/{{session_id}}/credentials/{{credentialId}}/validation",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{moderator_token}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{admin_token}}",
        "type": "string"
      }
    ]
  }
}
