---
config:
  layout: elk
  theme: redux
  look: neo
  flowchart:
    useMaxWidth: true
---
flowchart TB
    %% Actors
    C(("Client"))

    %% Entry Point
    AGW{{"API Gateway"}}

    %% Message Broker
    EB{{"RabbitMQ<br/>(AMQP Event Broker)"}}

    %% Java Services (Verification & Policy Core)
    subgraph Java_Services ["Java Services (Spring Boot)"]
        AS["Applicant Service"]
        CS["Credential Service"]
        SRS["Server Rules Service"]
        URS["University Record Service"]
    end

    %% Python Services (Game & Session Management)
    subgraph Python_Services ["Python Services (FastAPI)"]
        PS["Player Service"]
        SMS["Server Moderation<br/>Session Service"]
        MS["Moderation Service"]
        DMS["Discord DMs Service"]
    end

    %% Database Isolation (Polyglot Persistence)
    dbAS[("MongoDB<br/>(Claims)")] -.- AS
    dbCS[("MongoDB<br/>(Credentials)")] -.- CS
    dbSRS[("PostgreSQL<br/>(Rule Versions)")] -.- SRS
    dbURS[("MongoDB<br/>(University Facts)")] -.- URS

    dbPS[("PostgreSQL<br/>(Profiles & XP)")] -.- PS
    dbMS[("PostgreSQL<br/>(Decisions & Bans)")] -.- MS

    %% Dual-Database Services
    dbSMS_Redis[("Redis<br/>(Live State & Locks)")] -.- SMS
    dbSMS_PG[("PostgreSQL<br/>(Shift History)")] -.- SMS

    dbDMS_Redis[("Redis<br/>(Live WS Pub/Sub)")] -.- DMS
    dbDMS_Mongo[("MongoDB<br/>(Chat Channels & History)")] -.- DMS

    %% 1. Client to API Gateway
    C <-->|"WebSocket"| AGW
    C -->|"REST / HTTP Requests"| AGW

    %% 2. Gateway Routing & RBAC Constraints
    AGW -->|"Route REST<br/>(Auth / Profile / Teams / Friends)"| PS
    AGW -->|"Route REST<br/>(Start & Join Shift)"| SMS
    AGW -->|"Route REST<br/>(Read Public Claims)"| AS
    AGW -->|"Route REST<br/>(Read Credential Status)"| CS
    AGW -->|"Route REST<br/>(Inspect Records)<br/>[RBAC: Jr Mod Only]"| URS
    AGW -->|"Route REST<br/>(Submit Decision)<br/>[RBAC: Mod Only]"| MS
    AGW <-->|"Route WS<br/>(Chat Channels)"| DMS

    %% 3. Asynchronous Events (RabbitMQ)
    AS <.->|"Publish / Subscribe<br/>(CaseInitialized)"| EB
    CS <.->|"Publish / Subscribe<br/>(CaseInitialized)"| EB
    URS <.->|"Publish / Subscribe<br/>(CaseInitialized)"| EB

    MS -.->|"Publish<br/>(DecisionScored,<br/>DisciplinaryActionApplied)"| EB
    EB -.->|"Subscribe<br/>(DecisionScored)"| SMS

    SMS -.->|"Publish<br/>(ShiftEnded)"| EB
    EB -.->|"Subscribe<br/>(ShiftEnded,<br/>DisciplinaryActionApplied)"| PS

    %% 4. Internal Synchronous REST Communication
    SMS -->|"REST: Validate Team & Player Accounts"| PS
    MS -->|"REST: Fetch Claims"| AS
    MS -->|"REST: Fetch Validations"| CS
    MS -->|"REST: Fetch Univ Records"| URS
    MS -->|"REST: Evaluate Policy"| SRS

    %% 5. Internal Access Control Validations
    DMS -.->|"REST: Verify Session Role"| SMS
    DMS -.->|"REST: Verify View Permissions"| URS
