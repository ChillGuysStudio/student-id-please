{
  "info": {
    "_postman_id": "a4b9210f-2abd-4f96-a8e1-9a60deba3138",
    "name": "Student ID Please - Credential Service",
    "description": "Requests for every endpoint implemented by credential-service. Start the service with Docker Compose, then import this collection into Postman.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8082" },
    { "key": "idempotencyKey", "value": "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa" },
    { "key": "sessionId", "value": "bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb" },
    { "key": "caseId", "value": "" },
    { "key": "templateId", "value": "" },
    { "key": "credentialId", "value": "" }
  ],
  "item": [
    {
      "name": "Credential templates",
      "item": [
        {
          "name": "Create template",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('templateId', pm.response.json().template_id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{idempotencyKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"kind\": \"student_id\",\n  \"issuer\": \"Technical University of Moldova\",\n  \"validity_days\": 365,\n  \"enabled\": true\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/admin/credential-templates"
          }
        },
        {
          "name": "List templates",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/admin/credential-templates?limit=50"
          }
        },
        {
          "name": "Get template",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/admin/credential-templates/{{templateId}}"
          }
        },
        {
          "name": "Update template",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "cccccccc-cccc-4ccc-8ccc-cccccccccccc" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"kind\": \"student_id\",\n  \"issuer\": \"Technical University of Moldova\",\n  \"validity_days\": 180,\n  \"enabled\": true\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/admin/credential-templates/{{templateId}}"
          }
        },
        {
          "name": "Delete template",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Idempotency-Key", "value": "dddddddd-dddd-4ddd-8ddd-dddddddddddd" }
            ],
            "url": "{{baseUrl}}/api/v1/admin/credential-templates/{{templateId}}"
          }
        }
      ]
    },
    {
      "name": "Credential cases",
      "item": [
        {
          "name": "Initialize case",
          "description": "This internal endpoint requires the service's session and university-record integrations to accept the supplied session.",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 202) {",
                  "  pm.collectionVariables.set('caseId', pm.response.json().case_id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "eeeeeeee-eeee-4eee-8eee-eeeeeeeeeeee" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"session_id\": \"{{sessionId}}\",\n  \"scenario\": \"eligible\",\n  \"seed\": \"postman-credential-case\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/internal/v1/credential/cases"
          }
        },
        {
          "name": "Get case status",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/internal/v1/credential/cases/{{caseId}}/status"
          }
        },
        {
          "name": "List case credentials",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "if (pm.response.code === 200 && body.items.length > 0) {",
                  "  pm.collectionVariables.set('credentialId', body.items[0].credential_id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/sessions/{{sessionId}}/cases/{{caseId}}/credentials?limit=50"
          }
        },
        {
          "name": "Validate credential",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "ffffffff-ffff-4fff-8fff-ffffffffffff" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/sessions/{{sessionId}}/credentials/{{credentialId}}/validation"
          }
        },
        {
          "name": "Get credential results for moderation",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/internal/v1/cases/{{caseId}}/credential-results?session_id={{sessionId}}"
          }
        }
      ]
    }
  ]
}
