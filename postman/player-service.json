{
  "info": {
    "name": "Student ID Lab 1 - Player Service",
    "description": "Player API tests with fresh accounts and typed shift/discipline event fixtures. Supply session_token and moderation_token in a local environment. No Session API is required.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "player_url",
      "value": "http://localhost:8001"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{moderator_token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const name = pm.info.requestName;",
          "if (name === '200 Player health') {",
          "  pm.collectionVariables.set('run_id', pm.variables.replaceIn('{{$guid}}').replace(/-/g, '').slice(0, 12));",
          "  pm.collectionVariables.set('password', pm.variables.replaceIn('{{$guid}}') + 'Aa1!');",
          "}",
          "if (!['GET', 'HEAD'].includes(pm.request.method)) pm.request.headers.upsert({key: 'Idempotency-Key', value: pm.variables.replaceIn('{{$guid}}')});",
          "if (name === '200 Apply shift award') {",
          "  const id = pm.variables.replaceIn('{{$guid}}');",
          "  pm.collectionVariables.set('shift_event', JSON.stringify({event_id: pm.variables.replaceIn('{{$guid}}'), event_type: 'ShiftEnded', schema_version: 1, occurred_at: new Date().toISOString(), producer: 'session', correlation_id: id, payload: {session_id: id, participant_ids: [pm.collectionVariables.get('moderator_id'), pm.collectionVariables.get('junior1_id'), pm.collectionVariables.get('junior2_id')], processed_count: 1, score: 10, penalties: 0, ended_at: new Date().toISOString()}}));",
          "}",
          "if (name === '200 Apply discipline') {",
          "  const id = pm.variables.replaceIn('{{$guid}}');",
          "  pm.collectionVariables.set('discipline_event', JSON.stringify({event_id: pm.variables.replaceIn('{{$guid}}'), event_type: 'DisciplinaryActionApplied', schema_version: 1, occurred_at: new Date().toISOString(), producer: 'moderation', correlation_id: id, payload: {disciplinary_action_id: id, player_id: pm.collectionVariables.get('moderator_id'), xp_penalty: 3, reason: 'Lab 1 fixture'}}));",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const name = pm.info.requestName;",
          "pm.test('HTTP status matches contract', () => pm.response.to.have.status(Number(name.slice(0, 3))));",
          "pm.test('Request ID is present', () => pm.expect(pm.response.headers.get('X-Request-ID')).to.be.a('string'));",
          "if (pm.response.code !== 204) {",
          "  const body = pm.response.json();",
          "  let match = name.match(/Register (moderator|junior1|junior2)$/);",
          "  if (match && pm.response.code === 201) pm.collectionVariables.set(match[1] + '_id', body.player_id);",
          "  match = name.match(/Login (moderator|junior1|junior2)$/);",
          "  if (match && pm.response.code === 200) { pm.collectionVariables.set(match[1] + '_token', body.access_token); pm.collectionVariables.set(match[1] + '_refresh', body.refresh_token); }",
          "  const save = {'201 Request friendship 1': ['friendship1', 'friendship_id'], '201 Request friendship 2': ['friendship2', 'friendship_id'], '201 Create team': ['team_id', 'team_id']};",
          "  if (save[name] && pm.response.code < 300) pm.collectionVariables.set(save[name][0], body[save[name][1]]);",
          "  if (name === '200 Apply shift award' || name === '200 Apply discipline') pm.test('Event applied', () => pm.expect(body.applied).to.eql(true));",
          "  if (name === '200 Replay shift award' || name === '200 Replay discipline') pm.test('Duplicate ignored', () => pm.expect(body.applied).to.eql(false));",
          "  if (name === '200 Check shift XP') pm.test('Shift award applied once', () => pm.expect(body.xp).to.eql(10));",
          "  if (name === '200 Check disciplinary XP') pm.test('Penalty deducted once', () => pm.expect(body.xp).to.eql(7));",
          "  if (name === '200 Refresh token') { pm.collectionVariables.set('moderator_token', body.access_token); pm.collectionVariables.set('moderator_refresh', body.refresh_token); }",
          "  if (pm.response.code >= 400) pm.test('Typed error response', () => pm.expect(body).to.have.all.keys('code', 'message', 'request_id', 'details'));",
          "}"
        ]
      }
    }
  ],
  "item": [
