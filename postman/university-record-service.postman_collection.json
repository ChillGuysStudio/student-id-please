{
  "info": {
    "_postman_id": "5f420a87-0c85-466b-8880-a4f85b5df5ad",
    "name": "University Record Service local workflow",
    "description": "Creates all eight university reference kinds, checks CRUD and dependency protection, pins a snapshot, initializes a University-owned case, and reads its status and records.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080"
    },
    {
      "key": "admin_token",
      "value": "local-admin-token"
    },
    {
      "key": "service_token",
      "value": "local-service-token"
    }
  ],
  "item": [
    {
      "name": "Reference data",
      "item": [
        {
          "name": "Create program",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{program_key}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"kind\": \"program\",\n  \"subject_id\": null,\n  \"data\": {\n    \"code\": \"{{major}}\",\n    \"name\": \"Postman Program\",\n    \"study_years\": 4\n  }\n}"
            },
            "url": "{{base_url}}/api/v1/admin/university-data"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const suffix = Math.random().toString(36).slice(2, 5).toUpperCase().replace(/[^A-Z]/g, 'A');",
                  "const major = ('P' + suffix).slice(0, 4);",
                  "const startYear = 2030 + Math.floor(Math.random() * 60);",
                  "pm.collectionVariables.set('major', major);",
                  "pm.collectionVariables.set('course_id', major + '-API');",
                  "pm.collectionVariables.set('subject_id', pm.variables.replaceIn('{{$guid}}'));",
                  "pm.collectionVariables.set('session_id', pm.variables.replaceIn('{{$guid}}'));",
                  "pm.collectionVariables.set('program_key', pm.variables.replaceIn('{{$guid}}'));",
                  "pm.collectionVariables.set('replace_key', pm.variables.replaceIn('{{$guid}}'));",
                  "pm.collectionVariables.set('delete_key', pm.variables.replaceIn('{{$guid}}'));",
                  "pm.collectionVariables.set('missing_ref', pm.variables.replaceIn('{{$guid}}'));",
                  "pm.collectionVariables.set('academic_label', startYear + '-' + (startYear + 1));",
                  "pm.collectionVariables.set('academic_start', startYear + '-09-01T00:00:00Z');",
                  "pm.collectionVariables.set('autumn_end', (startYear + 1) + '-02-01T00:00:00Z');",
                  "pm.collectionVariables.set('academic_end', (startYear + 1) + '-09-01T00:00:00Z');",
                  "pm.collectionVariables.set('reference_at', startYear + '-09-10T10:00:00Z');",
                  "pm.collectionVariables.set('student_yy', String(startYear).slice(-2));",
                  "pm.collectionVariables.set('email', 'eliza.caraman' + Math.floor(1 + Math.random() * 1000000) + '@isa.utm.md');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('program_ref', pm.response.json().reference_id);"
                ]
              }
            }
          ],
          "description": "Creates a program reference with a random major code. Expects 201 and stores the reference ID."
        },
        {
          "name": "Replay program creation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{program_key}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"kind\": \"program\",\n  \"subject_id\": null,\n  \"data\": {\n    \"code\": \"{{major}}\",\n    \"name\": \"Postman Program\",\n    \"study_years\": 4\n  }\n}"
            },
            "url": "{{base_url}}/api/v1/admin/university-data"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('replay returns created', () => pm.response.to.have.status(201));",
                  "pm.test('replay preserves reference', () => pm.expect(pm.response.json().reference_id).to.eql(pm.collectionVariables.get('program_ref')));"
                ]
              }
            }
          ],
          "description": "Re-sends creation with the same idempotency key. Expects the original 201 and reference ID."
        },
        {
          "name": "Reject changed idempotent request",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{program_key}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"kind\": \"program\",\n  \"subject_id\": null,\n  \"data\": {\"code\": \"{{major}}\", \"name\": \"Changed request\", \"study_years\": 4}\n}"
            },
            "url": "{{base_url}}/api/v1/admin/university-data"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('idempotency conflict', () => pm.response.to.have.status(409));",
                  "pm.test('uses idempotency code', () => pm.expect(pm.response.json().code).to.eql('IDEMPOTENCY_CONFLICT'));"
                ]
              }
            }
          ],
          "description": "Reuses the creation key with a changed body. Expects 409 IDEMPOTENCY_CONFLICT."
        },
        {
          "name": "Read program",
