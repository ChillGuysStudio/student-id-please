e draft","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{admin_token}}"},{"key":"Idempotency-Key","value":"{{$guid}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"rules\":[],\"default_action\":\"reject\",\"default_channels\":[]}"},"url":"{{base_url}}/api/v1/rule-versions"},"event":[{"listen":"test","script":{"exec":["pm.test('disposable draft created', () => pm.response.to.have.status(201));","pm.collectionVariables.set('disposable_id', pm.response.json().rule_version);"]}}]},{"name":"Confirm disposable deletion","request":{"method":"DELETE","header":[{"key":"Authorization","value":"Bearer {{admin_token}}"},{"key":"Idempotency-Key","value":"{{delete_key}}"}],"url":"{{base_url}}/api/v1/rule-versions/{{disposable_id}}"},"event":[{"listen":"prerequest","script":{"exec":["pm.collectionVariables.set('delete_key', pm.variables.replaceIn('{{$guid}}'));"]}},{"listen":"test","script":{"exec":["pm.test('draft deleted', () => pm.response.to.have.status(204));","pm.test('delete body is empty', () => pm.expect(pm.response.text()).to.eql(''));"]}}]},{"name":"Replay disposable deletion","request":{"method":"DELETE","header":[{"key":"Authorization","value":"Bearer {{admin_token}}"},{"key":"Idempotency-Key","value":"{{delete_key}}"}],"url":"{{base_url}}/api/v1/rule-versions/{{disposable_id}}"},"event":[{"listen":"test","script":{"exec":["pm.test('delete replayed', () => pm.response.to.have.status(204));"]}}]}]},{"name":"Read current version","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{session_token}}"}],"url":"{{base_url}}/internal/v1/rule-versions/current"},"event":[{"listen":"test","script":{"exec":["pm.test('current version read', () => pm.response.to.have.status(200));","pm.test('current is published', () => pm.expect(pm.response.json().status).to.eql('published'));","pm.collectionVariables.set('current_id', pm.response.json().rule_version);"]}}]},{"name":"Evaluate FAF year 2 cas