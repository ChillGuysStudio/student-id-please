{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-4789-abcd-ef0123456789",
    "name": "Server Rules service",
    "description": "Public Gateway requests for the Server Rules service: draft, update, publish, and delete rule versions as an administrator, and read a version as a player. Set admin_token and player_token to Bearer access tokens. The collection can run repeatedly.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "gateway_url",
      "value": "http://127.0.0.1:8080"
    },
    {
      "key": "admin_token",
      "value": ""
    },
    {
      "key": "player_token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Draft rules",
      "item": [
        {
          "name": "Create draft",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{draft_key}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"rules\":[{\"rule_id\":\"{{rule_id}}\",\"priority\":5,\"kind\":\"major\",\"applies_to_roles\":[\"student\"],\"on_match\":\"reject\",\"allowed_channels\":[],\"condition\":{\"allowed_majors\":[\"FAF\"]}}],\"default_action\":\"reject\",\"default_channels\":[]}"
            },
            "url": "{{gateway_url}}/api/v1/rule-versions"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.collectionVariables.set('draft_key', pm.variables.replaceIn('{{$guid}}'));",
                  "pm.collectionVariables.set('rule_id', pm.variables.replaceIn('{{$guid}}'));",
                  "pm.collectionVariables.set('publish_key', pm.variables.replaceIn('{{$guid}}'));",
                  "pm.collectionVariables.set('missing_id', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('draft created', () => pm.response.to.have.status(201));",
                  "pm.test('draft status', () => pm.expect(pm.response.json().status).to.eql('draft'));",
                  "pm.collectionVariables.set('draft_id', pm.response.json().rule_version);"
                ]
              }
            }
          ],
          "description": "Creates a draft ruleset with one major rule. Expects 201 with status draft, and stores the rule version."
        },
        {
          "name": "Replay draft creation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{draft_key}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"rules\":[{\"rule_id\":\"{{rule_id}}\",\"priority\":5,\"kind\":\"major\",\"applies_to_roles\":[\"student\"],\"on_match\":\"reject\",\"allowed_channels\":[],\"condition\":{\"allowed_majors\":[\"FAF\"]}}],\"default_action\":\"reject\",\"default_channels\":[]}"
            },
            "url": "{{gateway_url}}/api/v1/rule-versions"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('creation replayed', () => pm.response.to.have.status(201));",
                  "pm.test('same version replayed', () => pm.expect(pm.response.json().rule_version).to.eql(pm.collectionVariables.get('draft_id')));"
                ]
              }
            }
          ],
          "description": "Re-sends creation with the same idempotency key. Expects the original 201 and rule version."
        },
        {
          "name": "Reject changed idempotent request",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{draft_key}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"rules\":[],\"default_action\":\"reject\",\"default_channels\":[]}"
            },
            "url": "{{gateway_url}}/api/v1/rule-versions"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('idempotency conflict', () => pm.response.to.have.status(409));",
                  "pm.test('uses idempotency code', () => pm.expect(pm.response.json().code).to.eql('IDEMPOTENCY_CONFLICT'));"
                ]
              }
            }
          ],
          "description": "Reuses the creation key with a different body. Expects 409 IDEMPOTENCY_CONFLICT."
        },
        {
          "name": "Read draft as admin",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{gateway_url}}/api/v1/rule-versions/{{draft_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('draft read', () => pm.response.to.have.status(200));",
                  "pm.test('identity preserved', () => pm.expect(pm.response.json().rule_version).to.eql(pm.collectionVariables.get('draft_id')));"
                ]
              }
            }
          ],
          "description": "Reads the draft back. Expects 200 with the same rule version."
        },
        {
          "name": "Reject draft read as player",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{player_token}}"
              }
            ],
            "url": "{{gateway_url}}/api/v1/rule-versions/{{draft_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('draft hidden from players', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ],
          "description": "Players cannot read drafts. Expects 403."
        },
        {
          "name": "Reject unauthenticated list",
          "request": {
            "method": "GET",
            "url": "{{gateway_url}}/api/v1/admin/rule-versions",
            "header": []
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('authentication required', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "description": "Lists without a token. Expects 401."
        },
        {
          "name": "Read missing ruleset",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{gateway_url}}/api/v1/rule-versions/{{missing_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('missing ruleset', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ],
          "description": "Reads an unknown rule version. Expects 404."
        },
        {
          "name": "List drafts",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{gateway_url}}/api/v1/admin/rule-versions?limit=10"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('listed', () => pm.response.to.have.status(200));",
                  "pm.test('contains draft', () => pm.expect(pm.response.json().items.some(item => item.rule_version === pm.collectionVariables.get('draft_id'))).to.be.true);",
                  "pm.collectionVariables.set('list_cursor', pm.response.json().next_cursor || '');"
                ]
              }
            }
          ],
          "description": "Lists rulesets with limit 10. Expects 200 containing the draft."
        },
        {
          "name": "Reject invalid page limit",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{gateway_url}}/api/v1/admin/rule-versions?limit=101"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('invalid limit rejected', () => pm.response.to.have.status(422));"
                ]
              }
            }
          ],
          "description": "limit=101 is outside the 1-100 range. Expects 422."
        },
        {
          "name": "Reject invalid ruleset",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"rules\":[{\"rule_id\":\"{{rule_id}}\",\"priority\":-1,\"kind\":\"major\",\"applies_to_roles\":[\"student\"],\"on_match\":\"reject\",\"allowed_channels\":[],\"condition\":{\"allowed_majors\":[\"FAF\"]}}],\"default_action\":\"reject\",\"default_channels\":[]}"
            },
            "url": "{{gateway_url}}/api/v1/rule-versions"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('invalid ruleset rejected', () => pm.response.to.have.status(422));",
                  "pm.test('uses ruleset code', () => pm.expect(pm.response.json().code).to.eql('INVALID_RULESET'));"
                ]
              }
            }
          ],
          "description": "A negative priority violates the contract bounds. Expects 422 INVALID_RULESET."
        },
        {
          "name": "Replace draft",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"rules\":[{\"rule_id\":\"{{rule_id}}\",\"priority\":5,\"kind\":\"major\",\"applies_to_roles\":[\"student\"],\"on_match\":\"reject\",\"allowed_channels\":[],\"condition\":{\"allowed_majors\":[\"FAF\"]}}],\"default_action\":\"accept\",\"default_channels\":[\"general\"]}"
            },
            "url": "{{gateway_url}}/api/v1/rule-versions/{{draft_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('draft replaced', () => pm.response.to.have.status(200));",
                  "pm.test('default updated', () => pm.expect(pm.response.json().default_action).to.eql('accept'));"
                ]
              }
            }
          ],
          "description": "Fully replaces the draft default. Expects 200 with the updated default."
        },
        {
          "name": "Publish draft",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{publish_key}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": "{{gateway_url}}/api/v1/rule-versions/{{draft_id}}/publish"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('published', () => pm.response.to.have.status(200));",
                  "pm.test('published status', () => pm.expect(pm.response.json().status).to.eql('published'));"
                ]
              }
            }
          ],
          "description": "Publishes the draft with an empty object. Expects 200 with status published."
        },
        {
          "name": "Replay publication",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{publish_key}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": "{{gateway_url}}/api/v1/rule-versions/{{draft_id}}/publish"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('publication replayed', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "description": "Replays publication with the original key. Expects the original 200."
        },
        {
          "name": "Reject republish with new key",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": "{{gateway_url}}/api/v1/rule-versions/{{draft_id}}/publish"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('republish rejected', () => pm.response.to.have.status(409));",
                  "pm.test('uses published code', () => pm.expect(pm.response.json().code).to.eql('RULE_VERSION_ALREADY_PUBLISHED'));"
                ]
              }
            }
          ],
          "description": "Publishes an already published version with a fresh key. Expects 409 RULE_VERSION_ALREADY_PUBLISHED."
        },
        {
          "name": "Reject published replacement",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"rules\":[],\"default_action\":\"reject\",\"default_channels\":[]}"
            },
            "url": "{{gateway_url}}/api/v1/rule-versions/{{draft_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('published replacement rejected', () => pm.response.to.have.status(409));",
                  "pm.test('uses immutable code', () => pm.expect(pm.response.json().code).to.eql('RULE_VERSION_IMMUTABLE'));"
                ]
              }
            }
          ],
          "description": "Replaces a published version. Expects 409 RULE_VERSION_IMMUTABLE."
        },
        {
          "name": "Reject published deletion",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "url": "{{gateway_url}}/api/v1/rule-versions/{{draft_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('published deletion rejected', () => pm.response.to.have.status(409));",
                  "pm.test('uses immutable code', () => pm.expect(pm.response.json().code).to.eql('RULE_VERSION_IMMUTABLE'));"
                ]
              }
            }
          ],
          "description": "Deletes a published version. Expects 409 RULE_VERSION_IMMUTABLE."
        },
        {
          "name": "Read published version as player",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{player_token}}"
              }
            ],
            "url": "{{gateway_url}}/api/v1/rule-versions/{{draft_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('published visible to players', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "description": "Published versions are visible to players. Expects 200."
        },
        {
          "name": "Delete disposable draft",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"rules\":[],\"default_action\":\"reject\",\"default_channels\":[]}"
            },
            "url": "{{gateway_url}}/api/v1/rule-versions"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('disposable draft created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('disposable_id', pm.response.json().rule_version);"
                ]
              }
            }
          ],
          "description": "Creates a throwaway draft for the delete flow. Expects 201 and stores its ID."
        },
        {
          "name": "Confirm disposable deletion",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{delete_key}}"
              }
            ],
            "url": "{{gateway_url}}/api/v1/rule-versions/{{disposable_id}}"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.collectionVariables.set('delete_key', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('draft deleted', () => pm.response.to.have.status(204));",
                  "pm.test('delete body is empty', () => pm.expect(pm.response.text()).to.eql(''));"
                ]
              }
            }
          ],
          "description": "Deletes the throwaway draft. Expects an empty 204."
        },
        {
          "name": "Replay disposable deletion",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{delete_key}}"
              }
            ],
            "url": "{{gateway_url}}/api/v1/rule-versions/{{disposable_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('delete replayed', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ],
          "description": "Replays the delete with the original key. Expects 204."
        }
      ],
      "description": "Draft lifecycle: create, read, replace, publish, and their guards."
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{admin_token}}",
        "type": "string"
      }
    ]
  }
}
