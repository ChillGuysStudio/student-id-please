          "description": "Deletes the throwaway draft. Expects an empty 204."
        },
        {
          "name": "Replay disposable deletion",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{delete_key}}"
              }
            ],
            "url": "{{base_url}}/api/v1/rule-versions/{{disposable_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('delete replayed', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ],
          "description": "Replays the delete with the original key. Expects 204."
        }
      ],
      "description": "Draft lifecycle: create, read, replace, publish, and their guards."
    },
    {
      "name": "Read current version",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{session_token}}"
          }
        ],
        "url": "{{base_url}}/internal/v1/rule-versions/current"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('current version read', () => pm.response.to.have.status(200));",
              "pm.test('current is published', () => pm.expect(pm.response.json().status).to.eql('published'));",
              "pm.collectionVariables.set('current_id', pm.response.json().rule_version);"
            ]
          }
        }
      ],
      "description": "Reads the current published ruleset as Session. Expects 200 with status published."
    },
    {
      "name": "Evaluate FAF year 2 case",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{moderation_token}}"
          },
          {
            "key": "X-Player-Id",
            "value": "33333333-3333-4333-8333-333333333333"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"session_id\":\"11111111-1111-4111-8111-111111111111\",\"case_id\":\"22222222-2222-4222-8222-222222222222\",\"rule_version\":\"88888888-8888-4888-8888-888888888888\",\"claims\":{\"first_name\":\"Eliza\",\"last_name\":\"Caraman\",\"student_id\":\"{{major}}-25-1\",\"major\":\"{{major}}\",\"year\":2,\"university_status\":\"active\",\"courses\":[],\"role\":\"student\",\"email\":\"eliza.caraman@isa.utm.md\"},\"subject_id\":\"{{subject_id}}\",\"reference_at\":\"2026-09-10T10:00:00Z\",\"credentials\":[{\"credential_id\":\"{{credential_id}}\",\"case_id\":\"22222222-2222-4222-8222-222222222222\",\"kind\":\"enrollment_confirmation\",\"holder_first_name\":\"Eliza\",\"holder_last_name\":\"Caraman\",\"student_id\":\"{{major}}-25-1\",\"issuer\":\"SIM-REGISTRY\",\"issued_at\":\"2026-09-01T00:00:00Z\",\"expires_at\":null,\"data\":{\"major\":\"{{major}}\",\"year\":2,\"status\":\"active\",\"role\":\"student\",\"enrolled_since\":\"2025-09-01T00:00:00Z\",\"academic_year\":\"2026-2027\",\"confirmation_number\":\"CONF-1\"}}],\"validations\":[{\"credential_id\":\"{{credential_id}}\",\"structurally_valid\":true,\"authentic\":true,\"expired\":false,\"issues\":[],\"checked_at\":\"2026-09-10T10:00:00Z\"}],\"university_records\":[{\"record_id\":\"{{enrollment_id}}\",\"case_id\":\"22222222-2222-4222-8222-222222222222\",\"kind\":\"enrollment\",\"subject_id\":\"{{subject_id}}\",\"data\":{\"student_id\":\"{{major}}-25-1\",\"first_name\":\"Eliza\",\"last_name\":\"Caraman\",\"major\":\"{{major}}\",\"year\":2,\"status\":\"active\",\"enrolled_since\":\"2025-09-01T00:00:00Z\",\"role\":\"student\"}},{\"record_id\":\"{{outlook_id}}\",\"case_id\":\"22222222-2222-4222-8222-222222222222\",\"kind\":\"outlook_group\",\"subject_id\":\"{{subject_id}}\",\"data\":{\"email\":\"eliza.caraman@isa.utm.md\",\"group_name\":\"students\",\"member\":true}},{\"record_id\":\"{{year_id}}\",\"case_id\":\"22222222-2222-4222-8222-222222222222\",\"kind\":\"academic_year\",\"subject_id\":null,\"data\":{\"label\":\"2026-2027\",\"starts_at\":\"2026-09-01T00:00:00Z\",\"ends_at\":\"2027-09-01T00:00:00Z\"}}],\"active_bans\":[],\"prior_decisions\":[]}"
        },
        "url": "{{base_url}}/internal/v1/policy/evaluations"
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const major = 'P' + Math.random().toString(36).slice(2, 5).toUpperCase().replace(/[^A-Z]/g, 'A');",
              "pm.collectionVariables.set('major', major.slice(0, 4));",
              "pm.collectionVariables.set('subject_id', pm.variables.replaceIn('{{$guid}}'));",
              "pm.collectionVariables.set('credential_id', pm.variables.replaceIn('{{$guid}}'));",
              "pm.collectionVariables.set('enrollment_id', pm.variables.replaceIn('{{$guid}}'));",
              "pm.collectionVariables.set('outlook_id', pm.variables.replaceIn('{{$guid}}'));",
              "pm.collectionVariables.set('year_id', pm.variables.replaceIn('{{$guid}}'));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('evaluation returned', () => pm.response.to.have.status(200));",
              "pm.test('non-FAF major rejected', () => pm.expect(pm.response.json().expected_action).to.eql('reject'));",
              "pm.test('major requirement cited', () => pm.expect(pm.response.json().reasons).to.include('MAJOR_REQUIREMENT'));"
            ]
          }
        }
      ],
      "description": "Evaluates evidence against the pinned baseline rules. The random non-FAF major fails its requirement, so it expects 200 with reject and MAJOR_REQUIREMENT."
    }
  ]
}
