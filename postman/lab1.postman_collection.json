{
  "info": {
    "name": "Student ID Lab 1 - Player and Session",
    "description": "Run the whole collection against compose.yaml with external services in mock mode. Supply moderation_token in a local Postman environment. Every run creates three players and one completed shift. The progression check polls for RabbitMQ delivery. Never export populated tokens to Git.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key": "player_url", "value": "http://localhost:8001"},
    {"key": "session_url", "value": "http://localhost:8002"}
  ],
  "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{moderator_token}}", "type": "string"}]},
  "event": [
    {"listen": "prerequest", "script": {"type": "text/javascript", "exec": [
      "const name = pm.info.requestName;",
      "if (name === '200 Player health') {",
      "  pm.collectionVariables.set('run_id', pm.variables.replaceIn('{{$guid}}').replace(/-/g, '').slice(0, 12));",
      "  pm.collectionVariables.set('password', pm.variables.replaceIn('{{$guid}}') + 'Aa1!');",
      "  pm.collectionVariables.set('progress_polls', 0);",
      "}",
      "if (!['GET', 'HEAD'].includes(pm.request.method)) { pm.request.headers.upsert({key: 'Idempotency-Key', value: pm.variables.replaceIn('{{$guid}}')}); }",
      "if (name === '200 Score current case') {",
      "  pm.collectionVariables.set('score_event', JSON.stringify({event_id: pm.variables.replaceIn('{{$guid}}'), event_type: 'DecisionScored', schema_version: 1, occurred_at: new Date().toISOString(), producer: 'moderation', correlation_id: pm.collectionVariables.get('case_id'), payload: {decision_id: pm.variables.replaceIn('{{$guid}}'), session_id: pm.collectionVariables.get('session_id'), case_id: pm.collectionVariables.get('case_id'), moderator_id: pm.collectionVariables.get('moderator_id'), action: 'accept', correct: true, score_delta: 10, penalty: 0}}));",
      "}",
      "if (name === '200 Apply discipline') {",
      "  const id = pm.variables.replaceIn('{{$guid}}');",
      "  pm.collectionVariables.set('discipline_event', JSON.stringify({event_id: pm.variables.replaceIn('{{$guid}}'), event_type: 'DisciplinaryActionApplied', schema_version: 1, occurred_at: new Date().toISOString(), producer: 'moderation', correlation_id: id, payload: {disciplinary_action_id: id, player_id: pm.collectionVariables.get('moderator_id'), xp_penalty: 3, reason: 'Lab 1 fixture'}}));",
      "}"
    ]}},
    {"listen": "test", "script": {"type": "text/javascript", "exec": [
      "const name = pm.info.requestName;",
      "pm.test('HTTP status matches contract', () => pm.response.to.have.status(Number(name.slice(0, 3))));",
      "pm.test('Request ID is present', () => pm.expect(pm.response.headers.get('X-Request-ID')).to.be.a('string'));",
      "if (pm.response.code !== 204) {",
      "  const body = pm.response.json();",
      "  let match = name.match(/Register (moderator|junior1|junior2)$/);",
      "  if (match && pm.response.code === 201) pm.collectionVariables.set(match[1] + '_id', body.player_id);",
      "  match = name.match(/Login (moderator|junior1|junior2)$/);",
      "  if (match && pm.response.code === 200) { pm.collectionVariables.set(match[1] + '_token', body.access_token); pm.collectionVariables.set(match[1] + '_refresh', body.refresh_token); }",
      "  const save = {'201 Request friendship 1': ['friendship1', 'friendship_id'], '201 Request friendship 2': ['friendship2', 'friendship_id'], '201 Create team': ['team_id', 'team_id'], '201 Create session': ['session_id', 'session_id'], '202 Create applicant case': ['case_id', 'case_id'], '201 Create disposable lobby': ['lobby_id', 'session_id']};",
      "  if (save[name] && pm.response.code < 300) pm.collectionVariables.set(save[name][0], body[save[name][1]]);",
      "  if (name === '200 Case readiness') pm.test('All three case owners are ready', () => pm.expect(body.ready_services).to.have.length(3));",
      "  if (name === '200 Score current case' || name === '200 Apply discipline') pm.test('Event applied', () => pm.expect(body.applied).to.eql(true));",
      "  if (name === '200 Replay scoring event' || name === '200 Replay discipline') pm.test('Duplicate ignored', () => pm.expect(body.applied).to.eql(false));",
      "  if (name === '200 End shift') pm.test('Shift totals are correct', () => {pm.expect(body.status).to.eql('ended'); pm.expect(body.score).to.eql(10); pm.expect(body.processed_count).to.eql(1);});",
      "  if (name === '200 Wait for progression') {",
      "    const count = Number(pm.collectionVariables.get('progress_polls'));",
      "    if (body.xp !== 10 && count < 20) { pm.collectionVariables.set('progress_polls', count + 1); pm.execution.setNextRequest(name); }",
      "    else pm.test('RabbitMQ delivered the shift award', () => pm.expect(body.xp).to.eql(10));",
      "  }",
      "  if (name === '200 Check disciplinary XP') pm.test('Penalty deducted once', () => pm.expect(body.xp).to.eql(7));",
      "  if (name === '200 Refresh token') { pm.collectionVariables.set('moderator_token', body.access_token); pm.collectionVariables.set('moderator_refresh', body.refresh_token); }",
      "  if (pm.response.code >= 400) pm.test('Typed error response', () => {pm.expect(body).to.have.all.keys('code', 'message', 'request_id', 'details');});",
      "}"
    ]}}
  ],
  "item": [
    {"name": "Player identity and teams", "item": [
      {"name": "200 Player health", "request": {"method": "GET", "url": "{{player_url}}/health", "auth": {"type": "noauth"}}},
      {"name": "200 Player readiness", "request": {"method": "GET", "url": "{{player_url}}/ready", "auth": {"type": "noauth"}}},
      {"name": "200 Public signing key", "request": {"method": "GET", "url": "{{player_url}}/.well-known/jwks.json", "auth": {"type": "noauth"}}},
      {"name": "201 Register moderator", "request": {"method": "POST", "url": "{{player_url}}/api/v1/players", "auth": {"type": "noauth"}, "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"username\":\"mod_{{run_id}}\",\"email\":\"mod_{{run_id}}@example.test\",\"password\":\"{{password}}\",\"display_name\":\"Moderator\"}"}}},
      {"name": "201 Register junior1", "request": {"method": "POST", "url": "{{player_url}}/api/v1/players", "auth": {"type": "noauth"}, "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"username\":\"j1_{{run_id}}\",\"email\":\"j1_{{run_id}}@example.test\",\"password\":\"{{password}}\",\"display_name\":\"Junior One\"}"}}},
      {"name": "201 Register junior2", "request": {"method": "POST", "url": "{{player_url}}/api/v1/players", "auth": {"type": "noauth"}, "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"username\":\"j2_{{run_id}}\",\"email\":\"j2_{{run_id}}@example.test\",\"password\":\"{{password}}\",\"display_name\":\"Junior Two\"}"}}},
      {"name": "200 Login moderator", "request": {"method": "POST", "url": "{{player_url}}/api/v1/auth/login", "auth": {"type": "noauth"}, "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"email\":\"mod_{{run_id}}@example.test\",\"password\":\"{{password}}\"}"}}},
      {"name": "200 Login junior1", "request": {"method": "POST", "url": "{{player_url}}/api/v1/auth/login", "auth": {"type": "noauth"}, "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"email\":\"j1_{{run_id}}@example.test\",\"password\":\"{{password}}\"}"}}},
      {"name": "200 Login junior2", "request": {"method": "POST", "url": "{{player_url}}/api/v1/auth/login", "auth": {"type": "noauth"}, "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"email\":\"j2_{{run_id}}@example.test\",\"password\":\"{{password}}\"}"}}},
      {"name": "200 Read profile", "request": {"method": "GET", "url": "{{player_url}}/api/v1/players/me"}},
      {"name": "200 Update profile", "request": {"method": "PATCH", "url": "{{player_url}}/api/v1/players/me", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"display_name\":\"Updated Moderator\"}"}}},
      {"name": "422 Reject client XP update", "request": {"method": "PATCH", "url": "{{player_url}}/api/v1/players/me", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"display_name\":\"Moderator\",\"xp\":999}"}}},
      {"name": "200 Read another player", "request": {"method": "GET", "url": "{{player_url}}/api/v1/players/{{junior1_id}}"}},
      {"name": "201 Request friendship 1", "request": {"method": "POST", "url": "{{player_url}}/api/v1/friendships", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"recipient_id\":\"{{junior1_id}}\"}"}}},
      {"name": "403 Reject requester acceptance", "request": {"method": "PUT", "url": "{{player_url}}/api/v1/friendships/{{friendship1}}/acceptance", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{}"}}},
      {"name": "200 Accept friendship 1", "request": {"method": "PUT", "url": "{{player_url}}/api/v1/friendships/{{friendship1}}/acceptance", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{junior1_token}}", "type": "string"}]}, "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{}"}}},
      {"name": "201 Request friendship 2", "request": {"method": "POST", "url": "{{player_url}}/api/v1/friendships", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"recipient_id\":\"{{junior2_id}}\"}"}}},
      {"name": "200 Accept friendship 2", "request": {"method": "PUT", "url": "{{player_url}}/api/v1/friendships/{{friendship2}}/acceptance", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{junior2_token}}", "type": "string"}]}, "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{}"}}},
      {"name": "200 List friendships", "request": {"method": "GET", "url": "{{player_url}}/api/v1/friendships?limit=1"}},
      {"name": "201 Create team", "request": {"method": "POST", "url": "{{player_url}}/api/v1/teams", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"name\":\"Demo moderators\"}"}}},
      {"name": "200 Add junior1", "request": {"method": "POST", "url": "{{player_url}}/api/v1/teams/{{team_id}}/members", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"player_id\":\"{{junior1_id}}\"}"}}},
      {"name": "200 Add junior2", "request": {"method": "POST", "url": "{{player_url}}/api/v1/teams/{{team_id}}/members", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"player_id\":\"{{junior2_id}}\"}"}}},
      {"name": "200 Read team", "request": {"method": "GET", "url": "{{player_url}}/api/v1/teams/{{team_id}}"}}
    ]},
    {"name": "Session lifecycle and scoring", "item": [
      {"name": "200 Session health", "request": {"method": "GET", "url": "{{session_url}}/health"}},
      {"name": "200 Session readiness", "request": {"method": "GET", "url": "{{session_url}}/ready"}},
      {"name": "201 Create session", "request": {"method": "POST", "url": "{{session_url}}/api/v1/sessions", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"team_id\":\"{{team_id}}\"}"}}},
      {"name": "409 Reject understaffed shift", "request": {"method": "POST", "url": "{{session_url}}/api/v1/sessions/{{session_id}}/start", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{}"}}},
      {"name": "200 Join junior1", "request": {"method": "POST", "url": "{{session_url}}/api/v1/sessions/{{session_id}}/participants", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{junior1_token}}", "type": "string"}]}, "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{}"}}},
      {"name": "200 Join junior2", "request": {"method": "POST", "url": "{{session_url}}/api/v1/sessions/{{session_id}}/participants", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{junior2_token}}", "type": "string"}]}, "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{}"}}},
      {"name": "200 Assign roles", "request": {"method": "PUT", "url": "{{session_url}}/api/v1/sessions/{{session_id}}/roles", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"participants\":[{\"player_id\":\"{{moderator_id}}\",\"role\":\"moderator\"},{\"player_id\":\"{{junior1_id}}\",\"role\":\"junior_moderator\"},{\"player_id\":\"{{junior2_id}}\",\"role\":\"junior_moderator\"}]}"}}},
      {"name": "200 List sessions", "request": {"method": "GET", "url": "{{session_url}}/api/v1/sessions"}},
      {"name": "200 Read session", "request": {"method": "GET", "url": "{{session_url}}/api/v1/sessions/{{session_id}}"}},
      {"name": "200 Start shift", "request": {"method": "POST", "url": "{{session_url}}/api/v1/sessions/{{session_id}}/start", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{}"}}},
      {"name": "403 Reject Junior Moderator case creation", "request": {"method": "POST", "url": "{{session_url}}/api/v1/sessions/{{session_id}}/cases", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{junior1_token}}", "type": "string"}]}, "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"entry_service\":\"applicant\"}"}}},
      {"name": "202 Create applicant case", "request": {"method": "POST", "url": "{{session_url}}/api/v1/sessions/{{session_id}}/cases", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"entry_service\":\"applicant\"}"}}},
      {"name": "409 Reject premature end", "request": {"method": "POST", "url": "{{session_url}}/api/v1/sessions/{{session_id}}/end", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{}"}}},
      {"name": "200 Case readiness", "request": {"method": "GET", "url": "{{session_url}}/api/v1/sessions/{{session_id}}/cases/{{case_id}}/status"}},
      {"name": "200 Internal context", "request": {"method": "GET", "url": "{{session_url}}/internal/v1/sessions/{{session_id}}/context?player_id={{moderator_id}}", "header": [{"key": "X-Service-Name", "value": "moderation"}, {"key": "X-Service-Token", "value": "{{moderation_token}}"}]}},
      {"name": "200 Score current case", "request": {"method": "POST", "url": "{{session_url}}/internal/v1/events", "auth": {"type": "noauth"}, "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "X-Service-Name", "value": "moderation"}, {"key": "X-Service-Token", "value": "{{moderation_token}}"}], "body": {"mode": "raw", "raw": "{{score_event}}"}}},
      {"name": "200 Replay scoring event", "request": {"method": "POST", "url": "{{session_url}}/internal/v1/events", "auth": {"type": "noauth"}, "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "X-Service-Name", "value": "moderation"}, {"key": "X-Service-Token", "value": "{{moderation_token}}"}], "body": {"mode": "raw", "raw": "{{score_event}}"}}},
      {"name": "200 End shift", "request": {"method": "POST", "url": "{{session_url}}/api/v1/sessions/{{session_id}}/end", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{}"}}},
      {"name": "200 Wait for progression", "request": {"method": "GET", "url": "{{player_url}}/api/v1/players/me"}},
      {"name": "201 Create disposable lobby", "request": {"method": "POST", "url": "{{session_url}}/api/v1/sessions", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"team_id\":\"{{team_id}}\"}"}}},
      {"name": "204 Delete lobby", "request": {"method": "DELETE", "url": "{{session_url}}/api/v1/sessions/{{lobby_id}}"}}
    ]},
    {"name": "Player progression and cleanup", "item": [
      {"name": "200 Apply discipline", "request": {"method": "POST", "url": "{{player_url}}/internal/v1/events", "auth": {"type": "noauth"}, "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "X-Service-Name", "value": "moderation"}, {"key": "X-Service-Token", "value": "{{moderation_token}}"}], "body": {"mode": "raw", "raw": "{{discipline_event}}"}}},
      {"name": "200 Replay discipline", "request": {"method": "POST", "url": "{{player_url}}/internal/v1/events", "auth": {"type": "noauth"}, "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "X-Service-Name", "value": "moderation"}, {"key": "X-Service-Token", "value": "{{moderation_token}}"}], "body": {"mode": "raw", "raw": "{{discipline_event}}"}}},
      {"name": "200 Check disciplinary XP", "request": {"method": "GET", "url": "{{player_url}}/api/v1/players/me"}},
      {"name": "200 Remove team member", "request": {"method": "DELETE", "url": "{{player_url}}/api/v1/teams/{{team_id}}/members/{{junior2_id}}"}},
      {"name": "204 Delete team", "request": {"method": "DELETE", "url": "{{player_url}}/api/v1/teams/{{team_id}}"}},
      {"name": "204 Remove friendship", "request": {"method": "DELETE", "url": "{{player_url}}/api/v1/friendships/{{friendship1}}"}},
      {"name": "200 Refresh token", "request": {"method": "POST", "url": "{{player_url}}/api/v1/auth/refresh", "auth": {"type": "noauth"}, "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"refresh_token\":\"{{moderator_refresh}}\"}"}}},
      {"name": "204 Logout", "request": {"method": "POST", "url": "{{player_url}}/api/v1/auth/logout", "auth": {"type": "noauth"}, "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"refresh_token\":\"{{moderator_refresh}}\"}"}}},
      {"name": "401 Reject logged-out refresh", "request": {"method": "POST", "url": "{{player_url}}/api/v1/auth/refresh", "auth": {"type": "noauth"}, "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"refresh_token\":\"{{moderator_refresh}}\"}"}}}
    ]}
  ]
}
