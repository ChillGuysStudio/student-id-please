# scripts/prepare_lab2.py creates ignored .env and .local/lab2 files for development.
# Service images as owner/repo:version. Any published tag works, including latest.
GATEWAY_IMAGE=maxnoragami/gateway-service:3.0.7
DISCOVERY_IMAGE=maxnoragami/discovery-service:3.0.6
PLAYER_IMAGE=tirppy/student-id-player-service:3.0.0
SESSION_IMAGE=tirppy/student-id-session-service:3.0.8
MODERATION_IMAGE=sentientmoss/pad-moderation-service:3.0.5
DISCORD_DMS_IMAGE=sentientmoss/pad-discord-dms-service:3.0.3
APPLICANT_IMAGE=mcittkmims/applicant-service:3.0.3
CREDENTIAL_IMAGE=mcittkmims/credential-service:3.0.5
UNIVERSITY_RECORD_IMAGE=maxnoragami/university-record-service:3.0.4
SERVER_RULES_IMAGE=maxnoragami/server-rules-service:3.0.5
GATEWAY_PORT=8080
DMS_PORT=8009
# Replicas per domain service. Per-service override: <SERVICE>_REPLICAS, e.g. SESSION_REPLICAS=3.
# After changing, run `python3 scripts/replicas.py` and `docker compose up -d --remove-orphans`.
REPLICAS=2
REPLICA_SEED=
DMS_REPLICA_PORT_BASE=18009
COMPOSE_FILE=compose.yaml:compose.replicas.yaml
HTTP_TASK_TIMEOUT_SECONDS=30
HTTP_MAX_CONCURRENT_TASKS=100
JAVA_TASK_TIMEOUT=30s
PLAYER_DB_PASSWORD=
SESSION_DB_PASSWORD=
MODERATION_DB_PASSWORD=
DMS_DB_PASSWORD=
RABBITMQ_PASSWORD=
APPLICANT_BROKER_PASSWORD=
CREDENTIAL_BROKER_PASSWORD=
UNIVERSITY_BROKER_PASSWORD=
REDIS_PASSWORD=
SESSION_SERVICE_TOKEN=
MODERATION_SERVICE_TOKEN=
DISCORD_DMS_SERVICE_TOKEN=
CHAT_TICKET_SECRET=
UNIVERSITY_MONGO_PASSWORD=
RULES_DB_PASSWORD=
RULES_CURSOR_SECRET=
# Lab 3 registration. scripts/prepare_lab2.py generates the IDs and tokens.
# DISCOVERY_URL defaults to http://discovery-slot-1:8081 when unset.
GATEWAY_CONTROL_TOKEN=
DISCOVERY_CONTROL_TOKEN=
OPERATOR_CONTROL_TOKEN=
APPLICANT_CONTROL_TOKEN=
CREDENTIAL_CONTROL_TOKEN=
UNIVERSITY_RECORD_CONTROL_TOKEN=
SERVER_RULES_CONTROL_TOKEN=
MODERATION_CONTROL_TOKEN=
PLAYER_CONTROL_TOKEN=
SESSION_CONTROL_TOKEN=
DISCORD_DMS_CONTROL_TOKEN=
GATEWAY_INSTANCE_ID=
DISCOVERY_INSTANCE_ID=
APPLICANT_SLOT1_INSTANCE_ID=
CREDENTIAL_SLOT1_INSTANCE_ID=
UNIVERSITY_RECORD_SLOT1_INSTANCE_ID=
SERVER_RULES_SLOT1_INSTANCE_ID=
MODERATION_SLOT1_INSTANCE_ID=
PLAYER_SLOT1_INSTANCE_ID=
SESSION_SLOT1_INSTANCE_ID=
DISCORD_DMS_SLOT1_INSTANCE_ID=
DISCOVERY_DISCORD_WEBHOOK_URL=
