            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"participants\":[{\"player_id\":\"{{moderator_id}}\",\"role\":\"moderator\"},{\"player_id\":\"{{junior1_id}}\",\"role\":\"junior_moderator\"},{\"player_id\":\"{{junior2_id}}\",\"role\":\"junior_moderator\"}]}"
            }
          }
        },
        {
