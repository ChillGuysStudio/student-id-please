            }
          ],
          "description": "Fully replaces the program name. Expects 200 with the same reference ID."
        },
        {
          "name": "Replay program replacement",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{replace_key}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"kind\": \"program\",\n  \"subject_id\": null,\n  \"data\": {\"code\": \"{{major}}\", \"name\": \"Updated Postman Program\", \"study_years\": 4}\n}"
            },
            "url": "{{base_url}}/api/v1/admin/university-data/{{program_ref}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('replacement replayed', () => pm.response.to.have.status(200));",
                  "pm.test('replacement replay preserves identity', () => pm.expect(pm.response.json().reference_id).to.eql(pm.collectionVariables.get('program_ref')));"
                ]
              }
            }
          ],
          "description": "Replays the replacement with the original key. Expects the original 200."
        },
        {
          "name": "Reject course deletion while in use",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{conflict_key}}"
              }
            ],
            "url": "{{base_url}}/api/v1/admin/university-data/{{course_ref}}"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.collectionVariables.set('conflict_key', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('dependency protected', () => pm.response.to.have.status(409));",
                  "pm.test('uses contract code', () => pm.expect(pm.response.json().code).to.eql('REFERENCE_IN_USE'));"
                ]
              }
            }
          ],
          "description": "Deletes a course that has schedules and registrations. Expects 409 REFERENCE_IN_USE."
        },
        {
          "name": "Replay failed course deletion",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{conflict_key}}"
              }
            ],
            "url": "{{base_url}}/api/v1/admin/university-data/{{course_ref}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('failed deletion replayed', () => pm.response.to.have.status(409));",
                  "pm.test('original failure preserved', () => pm.expect(pm.response.json().code).to.eql('REFERENCE_IN_USE'));"
                ]
              }
            }
          ],
          "description": "Replays the failed delete with the original key. Expects the original 409."
        },
        {
          "name": "Create disposable FCIM message",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"kind\":\"fcim_message\",\"subject_id\":\"{{subject_id}}\",\"data\":{\"author_first_name\":\"Eliza\",\"author_last_name\":\"Caraman\",\"channel\":\"temporary\",\"text\":\"Delete me\",\"sent_at\":\"{{reference_at}}\"}}"
            },
            "url": "{{base_url}}/api/v1/admin/university-data"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('disposable reference created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('disposable_ref', pm.response.json().reference_id);"
                ]
              }
            }
          ],
          "description": "Creates a throwaway message for the delete flow. Expects 201."
        },
        {
          "name": "Delete disposable reference",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{delete_key}}"
              }
            ],
            "url": "{{base_url}}/api/v1/admin/university-data/{{disposable_ref}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('reference deleted', () => pm.response.to.have.status(204));",
                  "pm.test('delete body is empty', () => pm.expect(pm.response.text()).to.eql(''));"
                ]
              }
            }
          ],
          "description": "Deletes the throwaway message. Expects an empty 204."
        },
        {
          "name": "Replay reference deletion",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{delete_key}}"
              }
            ],
            "url": "{{base_url}}/api/v1/admin/university-data/{{disposable_ref}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('delete replayed', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ],
          "description": "Replays the delete with the original key. Expects 204."
        }
      ],
      "description": "Reference CRUD across all eight kinds, plus idempotency, auth, and pagination checks."
    },
    {
      "name": "Snapshot and case",
      "item": [
        {
          "name": "Create snapshot",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{service_token}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"session_id\":\"{{session_id}}\",\"reference_at\":\"{{reference_at}}\"}"
            },
            "url": "{{base_url}}/internal/v1/university-snapshots"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('snapshot created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('snapshot_id', pm.response.json().snapshot_id);"
                ]
              }
            }
          ],
          "description": "Pins an immutable snapshot for the session. Expects 201."
        },
        {
          "name": "Initialize existing-subject case",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{service_token}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"session_id\":\"{{session_id}}\",\"scenario\":\"eligible\",\"seed\":\"postman-case\",\"subject_id\":\"{{subject_id}}\"}"
            },
            "url": "{{base_url}}/internal/v1/university-record/cases"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('case accepted', () => pm.response.to.have.status(202));",
                  "pm.test('initial response is pending', () => pm.expect(pm.response.json().state).to.eql('pending'));",
                  "pm.collectionVariables.set('case_id', pm.response.json().case_id);"
                ]
              }
            }
          ],
          "description": "Initializes a University-owned case for the subject. Expects 202 with state pending."
        },
        {
          "name": "Read case status",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{service_token}}"
              }
            ],
            "url": "{{base_url}}/internal/v1/university-record/cases/{{case_id}}/status"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('case ready', () => pm.response.to.have.status(200));",
                  "pm.test('state is ready', () => pm.expect(pm.response.json().state).to.eql('ready'));"
                ]
              }
            }
          ],
          "description": "Reads the local case state. Expects 200 with state ready."
        },
        {
          "name": "Read complete university records",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{service_token}}"
              }
            ],
            "url": "{{base_url}}/internal/v1/cases/{{case_id}}/university-records?session_id={{session_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('records returned', () => pm.response.to.have.status(200));",
                  "pm.test('records are non-empty', () => pm.expect(pm.response.json().records.length).to.be.above(0));",
                  "pm.test('subject retained', () => pm.expect(pm.response.json().subject_id).to.eql(pm.collectionVariables.get('subject_id')));",
                  "pm.collectionVariables.set('original_case', pm.response.text());"
                ]
              }
            }
          ],
          "description": "Reads the full case records for Moderation. Expects 200 with the subject's records."
        }
      ],
      "description": "Snapshot pinning, University case initialization, and complete record reads."
    },
    {
      "name": "Read replace and delete every kind",
      "item": [
        {
          "name": "Collect this run's references",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "url": "{{base_url}}/api/v1/admin/university-data?limit=100"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('list available', () => pm.response.to.have.status(200));",
                  "const subject = pm.collectionVariables.get('subject_id');",
                  "const ids = ['program_ref', 'course_ref', 'schedule_ref', 'year_ref'].map(k => pm.collectionVariables.get(k));",
                  "const order = ['fcim_message', 'registration', 'outlook_group', 'schedule', 'enrollment', 'course', 'academic_year', 'program'];",
                  "const rows = pm.response.json().items.filter(r => r.subject_id === subject || ids.includes(r.reference_id)).sort((a,b) => order.indexOf(a.kind) - order.indexOf(b.kind));",
                  "pm.test('all eight kinds selected', () => pm.expect(new Set(rows.map(r => r.kind)).size).to.eql(8));",
                  "pm.collectionVariables.set('crud_queue', JSON.stringify(rows));",
                  "pm.collectionVariables.set('crud_index', 0);"
                ]
              }
            }
          ],
          "description": "Selects this run's references into the loop queue. Expects 200 with all eight kinds."
        },
        {
          "name": "Read each reference",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "url": "{{base_url}}/api/v1/admin/university-data/{{crud_id}}"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const rows = JSON.parse(pm.collectionVariables.get('crud_queue'));",
                  "const row = rows[Number(pm.collectionVariables.get('crud_index'))];",
                  "pm.collectionVariables.set('crud_id', row.reference_id);",
                  "pm.collectionVariables.set('crud_kind', row.kind);",
                  "const body = {kind: row.kind, subject_id: row.subject_id, data: row.data};",
                  "if (row.kind === 'program') body.data.name = 'Replaced program';",
                  "if (row.kind === 'course') body.data.title = 'Replaced course';",
                  "if (row.kind === 'fcim_message') body.data.text = 'Replaced message';",
                  "if (row.kind === 'enrollment') body.data.first_name = 'Larisa';",
                  "pm.collectionVariables.set('crud_body', JSON.stringify(body));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('GET ' + pm.collectionVariables.get('crud_kind'), () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "description": "Reads the current loop reference. Expects 200."
        },
        {
          "name": "Replace each reference",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{{crud_body}}"
            },
            "url": "{{base_url}}/api/v1/admin/university-data/{{crud_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('PUT ' + pm.collectionVariables.get('crud_kind'), () => pm.response.to.have.status(200));",
                  "pm.test('replacement data persisted', () => pm.expect(pm.response.json().data).to.deep.eql(JSON.parse(pm.collectionVariables.get('crud_body')).data));",
                  "pm.test('reference identity retained', () => pm.expect(pm.response.json().reference_id).to.eql(pm.collectionVariables.get('crud_id')));"
                ]
              }
            }
          ],
          "description": "Replaces the current loop reference. Expects 200 with persisted data and retained identity."
        },
        {
          "name": "Delete each reference",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "url": "{{base_url}}/api/v1/admin/university-data/{{crud_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('DELETE ' + pm.collectionVariables.get('crud_kind'), () => pm.response.to.have.status(204));",
                  "pm.test('empty delete result', () => pm.expect(pm.response.text()).to.eql(''));"
                ]
              }
            }
          ],
          "description": "Deletes the current loop reference. Expects an empty 204."
        },
        {
          "name": "Confirm each reference was deleted",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "url": "{{base_url}}/api/v1/admin/university-data/{{crud_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('deleted ' + pm.collectionVariables.get('crud_kind') + ' is absent', () => pm.response.to.have.status(404));",
                  "const index = Number(pm.collectionVariables.get('crud_index')) + 1;",
                  "pm.collectionVariables.set('crud_index', index);",
                  "if (index < JSON.parse(pm.collectionVariables.get('crud_queue')).length) pm.execution.setNextRequest('Read each reference');"
                ]
              }
            }
          ],
          "description": "Reads back the deleted reference and advances the loop. Expects 404."
        },
        {
          "name": "Case remains immutable after reference deletion",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{service_token}}"
              }
            ],
            "url": "{{base_url}}/internal/v1/cases/{{case_id}}/university-records?session_id={{session_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('case remains available', () => pm.response.to.have.status(200));",
                  "pm.test('case is byte-for-byte unchanged', () => pm.expect(pm.response.text()).to.eql(pm.collectionVariables.get('original_case')));"
                ]
              }
            }
          ],
          "description": "Re-reads the case after all deletions. Expects the byte-for-byte identical record set."
        }
      ],
      "description": "Loops read, replace, delete, and read-again over every reference kind, then proves the case is unchanged. Run the whole folder in the Runner; single requests depend on the collector."
    }
  ]
}
