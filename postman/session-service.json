                "value": "moderation"
              },
              {
                "key": "X-Service-Token",
                "value": "{{moderation_token}}"
              }
            ]
          }
        },
        {
          "name": "200 Score current case",
          "request": {
            "method": "POST",
            "url": "{{session_url}}/internal/v1/events",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
